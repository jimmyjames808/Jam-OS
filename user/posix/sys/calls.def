/* The Linux calls the layer answers: one line per call, its handler
 * lx_<name> in its area's file (calls.h), by area. Read by calls.c (the
 * table, by Linux's number) and by the override of syscall_arch.h (the
 * reference each of musl's call sites makes to its call's handler), so a
 * program links the handlers it can call and no others.
 *
 *   LX(name)     a call musl makes with __syscallN, inline: the call site
 *                names the handler, which is linked only if some site does
 *   LX_CP(name)  a call that can be a cancellation point too (musl's
 *                syscall_cp, a function called with the number): always
 *                linked, since such a site names nothing
 *
 * A call made where the number is known only when it runs (musl's public
 * syscall()) names every handler (__jam_calls_all, callsall.c).
 *
 * Adding a call: write lx_<name> in the area's file, declare it in
 * calls.h, and add its line here, LX_CP if any of musl's wrappers reach it
 * through syscall_cp (`grep -rn 'syscall_cp\|socketcall_cp' src` in
 * third_party/musl). No include guard: each reader defines LX and LX_CP
 * first. */

/* memory: mem.c */
LX(mmap)
LX(munmap)
LX(mprotect)
LX(madvise)
LX(mincore)
LX(pkey_alloc)
LX(pkey_free)
LX(pkey_mprotect)
LX(mremap)
LX(brk)
LX(mlock)
LX(munlock)
LX(mlock2)
LX(mlockall)
LX(munlockall)
LX_CP(msync)

