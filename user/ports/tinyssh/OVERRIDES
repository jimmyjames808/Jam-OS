subprocess_auth.c c32e7426846d27770014a45b46bbde2bfd510f15411846e35f7ae474d390fb85 user/ports/tinyssh/subprocess_auth.c
# The multi-call wrapper: tinysshd, its two helpers and the listener (sshd.c).
