# console: the console process (user/services/console) serves this to
# programs (the shell), devmgr and init. Each console is a terminal: a
# window on the compositor's desktop (/svc/wayland), whose text it draws
# into the window's buffers and mirrors to the serial port; the
# compositor owns the screen and the input (M12's Q14: the full-screen
# console, its input sources and its lent screen are gone). A console
# started with the argument "conn" is a terminal on a connection instead:
# its output goes out as bytes on a master channel, the keys come in on it,
# and its size comes on a conn_ctl channel (conn_ctl.idl, <termconn.h>); the
# methods below are the same. Format: see tools/genidl.py.
#
# Restart: if the channel's peer closes (the console restarted), clients
# ask devmgr/init for the new one. The console keeps nothing across a
# restart: what was in the window and the key channels are made again.

protocol console 12

# 1 (write with a length and a fixed 2048-byte array): gone (the review's
# finding 18), not reused: 11.

2  size   () -> (u16 cols, u16 rows)
3  clear  () -> ()
# A channel on which the console sends this client the keys typed while it
# is the focused client (the most recent open_keys wins; closing the
# channel gives focus back): the `keys` protocol's events (below; review
# W14: an IDL protocol, no mouse).
4  open_keys      () -> (handle keys)
# 5 (connect_input) and 6 (lend_screen): gone with the full-screen console
# (M12's Q14); not reused.

# A new client channel with less authority. Levels: 0 ADMIN
# (the channels init hands the console at start: init's), 1 SHELL (the
# shell's), 2 PROGRAM (write, size, clear, open_keys: what the shell gives
# a program it runs; the shell kills the program's job when it ends, so
# the channel lives only while the program is in the foreground). A
# caller may only make a level above its own: ERR_ACCESS_DENIED
# otherwise, ERR_INVALID_ARGS for a level > 2. While a PROGRAM client has
# the focus, Ctrl+C also goes to the SHELL or ADMIN client below it (the
# shell that ran it kills it): a program can't trap the keys.
7  new_client     (u8 level) -> (handle client)
# 8 (blank): gone with the full-screen console (the compositor blanks the
# screen: compctl.blank); not reused.

# Ask for the kernel log on the screen (on 1), or stop asking (on 0). A
# console started with the argument "nolog" (init's, on a plain boot with
# the splash) keeps the log off the screen, and shows it only while some
# channel asks: the shell asks while a command
# whose output is the log runs (the kernel's commands, `ktest`, `ps -k`,
# ...; the test programs; a program it runs). `only` (NUL-padded) names a
# process: then just its lines ("[name] ...") and the kernel's own are
# shown, so a program's run doesn't bring the background services' lines;
# empty: every line. A channel that closes stops asking. Without "nolog"
# the log is always on the screen and this changes nothing. ADMIN and
# SHELL channels only: ERR_ACCESS_DENIED for a PROGRAM one.
9  show_log       (u8 on, u8[32] only) -> ()
# The terminal window's font (the settings' terminal.font, which init
# reads when /data comes and sends to every terminal's console): font 0
# smooth (JetBrains Mono, the default), 1 the 8x16 bitmap. The window
# keeps its size; its grid is made again in the new cells. A console with
# no window (no compositor) has nothing to change: OK. ADMIN channels
# only: ERR_ACCESS_DENIED otherwise; ERR_INVALID_ARGS for a font > 1.
10 set_font       (u8 font) -> ()
# Write text: up to 2048 bytes, as the program wrote them (UTF-8; \n, \r,
# \b, \t and ESC [ ... m colours understood; bytes, not a str: a
# program's output may be any bytes, and the terminal shows them). Also
# copied to COM1. All levels.
11 write          (u8[<=2048] text) -> ()
# A terminal for a POSIX program (docs/M13-PLAN.md, "The terminal
# layer"): `tty` a channel of the `tty` protocol (below), `input` the read
# end of a pipe (a channel of byte messages) the console writes what is
# typed into, after the terminal's line discipline (<ldisc.h>: in
# canonical mode one line per message, an empty message the end of file),
# `output` the write end of a pipe the console reads and shows (messages
# of at most TTY_OUT_MAX bytes; a longer one, or one carrying handles,
# ends the terminal's client). Like open_keys, it takes the focus: the
# keys typed go to it as bytes (<keybytes.h>, or as they came over a
# connection) until its `tty` channel closes, when what it left unread in
# `input` goes back to the terminal for the next reader. All levels; at
# most 8 at once (ERR_NO_RESOURCES), and a PROGRAM client can't push out
# the shell's focus (ERR_NO_RESOURCES when the focus stack is full).
12 open_tty       () -> (handle tty, handle input, handle output)

# keys: the channel console.open_keys answers (review W14, DQ1: events
# from the console to its client, in the IDL; the struct a size told apart
# went with the mouse it carried, M12's Q14). The console sends the
# focused client its keys; the client sends nothing (what it writes is
# never read: a terminal program gets the mouse as xterm's escape
# sequences from M13's terminal layer).
#
# Reconnect: the channel lives as long as the client keeps it and the
# console runs. If its peer closes (the console restarted), the client's
# console channel has closed too: it asks devmgr/init for the new console,
# and opens the keys again there; keys typed meanwhile are lost.

protocol keys 41

# One key: the HID usage (input.idl's: the Keyboard/Keypad page; 0 for a
# character pasted or typed by a terminal, with the character alone; a
# keypad key with Num Lock off as the key printed on it), its state
# (input.idl's INPUT_KEY_UP, DOWN or REPEAT: the console's window repeats
# a key held down), the modifiers (INPUT_MOD_*: the left keys) and the
# character it types on the layout, 0 for none (an arrow, a modifier).
1  key  -> (u16 usage, u8 state, u8 mods, u32 codepoint) event

# tty: the terminal's POSIX side, the channel console.open_tty answers
# (docs/M13-PLAN.md, "The terminal layer"; libc's terminal descriptor,
# user/posix/sys/tty.c, is this channel and the two pipes). The settings
# are the terminal's (one line discipline per console, <ldisc.h>), not the
# channel's: a set_attr holds for every client of the terminal, the next
# program's too. They are Linux's struct termios field for field (bits,
# c_cc indices), which libc passes through unchanged.
#
# Reconnect: the channel lives as long as the console runs and some
# process keeps it. If its peer closes (the console ended, the terminal
# hung up), the terminal is gone: libc's reads of the input pipe see the
# end of the file and its writes EPIPE; nothing is opened again.

protocol tty 43

# The most bytes in one message on the output pipe (console.write's).
const OUT_MAX 2048
# set_attr's `when` (Linux's TCSANOW, TCSADRAIN, TCSAFLUSH).
const WHEN_NOW 0
const WHEN_DRAIN 1
const WHEN_FLUSH 2
# flush's `queue` (Linux's TCIFLUSH, TCOFLUSH, TCIOFLUSH).
const QUEUE_IN 0
const QUEUE_OUT 1
const QUEUE_BOTH 2
# signal's `sig`.
const SIG_INT 1
const SIG_QUIT 2

# The terminal's settings.
1  get_attr  () -> (u32 iflag, u32 oflag, u32 cflag, u32 lflag, u8[32] cc, u32 ispeed, u32 ospeed)
# New settings: at once (WHEN_NOW), after the output written so far is
# shown (WHEN_DRAIN), or after that with the input not yet read thrown away
# (WHEN_FLUSH):
# the pipe's unread messages and the line being edited. Every bit is kept
# (one that means nothing to the console changes nothing, as on a Linux
# pseudo-terminal); `when` > 2: ERR_INVALID_ARGS.
2  set_attr  (u8 when, u32 iflag, u32 oflag, u32 cflag, u32 lflag, u8[32] cc, u32 ispeed, u32 ospeed) -> () later
# Answered once the output written before it has been shown.
3  drain     () -> () later
# Throw away input not yet read (QUEUE_IN), output not yet shown
# (QUEUE_OUT), or both (QUEUE_BOTH).
# `queue` > 2: ERR_INVALID_ARGS.
4  flush     (u8 queue) -> ()
# The terminal's size in cells (console.size's).
5  get_size  () -> (u16 cols, u16 rows)
# To the client: the terminal is now cols x rows (a window resized, the
# remote terminal's resize): libc raises SIGWINCH. Sent to every client
# of the terminal; dropped for one whose channel is full.
6  size      -> (u16 cols, u16 rows) event
# To the client: ISIG's key was typed (SIG_INT, SIG_QUIT) while this
# client had the focus and no SHELL or ADMIN client's keys were below it
# to take it (a pseudo-terminal, a program alone on a terminal): libc
# raises SIGINT or SIGQUIT in its process. With a shell below, the shell
# gets the key instead (Ctrl+C, or Ctrl+\) and signals the program.
7  signal    -> (u8 sig) event
