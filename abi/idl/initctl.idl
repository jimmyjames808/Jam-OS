# initctl: init's control channel, served by init in shell mode
# (user/services/init/ctl.c). The shell holds one client end (startup role
# SR_USER + 3: every method) and the console another (SR_USER + 8: reboot
# only; the rest ERR_ACCESS_DENIED), so what a holder may ask is decided by
# which channel it holds. After ERR_PEER_CLOSED there is nothing to
# reconnect to: init is gone, and with it whoever would restart anything;
# `reboot` callers fall back to the reboot system call.
# Format: see tools/genidl.py.

protocol initctl 18

# Kill the process called `name` (NUL-terminated, no spaces) and answer
# with its kernel object id once it is dead: a service init runs ("console",
# "serialin", "devmgr", "bootfs", "logd", "shell"; init starts it again), or
# what devmgr runs for a USB device: a class driver ("hid-6.1:0",
# "usb-storage-1:0") or a disk's filesystem service ("fat-data"); devmgr
# restarts it. ERR_NOT_FOUND: no such process; ERR_INVALID_ARGS: not a
# name; ERR_ACCESS_DENIED: "init" itself.
1  kill  (u8[32] name) -> (u64 koid)
# Everything written to /data is on the stick (fs.sync), waiting at most
# 2 s. OK also when there is no /data.
2  sync  () -> ()
# sync, then reset the machine. Answers only if the reset failed.
3  reboot  () -> ()
