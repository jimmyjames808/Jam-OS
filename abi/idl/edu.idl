# edu: QEMU's `edu` test device, as its driver (drivers/edu) serves it.
# Format: see tools/genidl.py.
#
# Reconnect (M7 supervision, user/include/devmgr.h): devmgr restarts the
# edu driver when it dies. A call that fails with ERR_PEER_CLOSED means
# the driver died: get the service channel from devmgr again
# (DEVMGR_GET_SERVICE; while the restart is due it already hands out the
# new channel, and calls on it wait for the new driver) and retry. The
# driver keeps nothing across a restart: a dma_start transfer the old one
# had running is gone (the kernel quarantined its pages).

protocol edu 2

# n! computed by the device (32 bits, wrapping like the device does),
# waiting for its completion interrupt.
1  factorial      (u32 n)    -> (u32 result)
# RAM -> device -> RAM through a pinned DMA32 VMO, len bytes (1..4096):
# the call's status says whether the data came back intact.
2  dma_roundtrip  (u32 len)  -> ()
# Raise the device's interrupt and wait for it: the time from the raise to
# the driver thread waking.
3  raise_irq      ()         -> (u64 latency_ns)
# Pin a buffer and start a RAM -> device DMA of len bytes, then answer at
# once: the transfer is still running (QEMU's edu takes ~100 ms) and the
# pin is held until the driver's next call. For the kill-mid-DMA tests.
4  dma_start      (u32 len)  -> (u64 device_addr)
