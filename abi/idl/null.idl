# null: the M6 test protocol (an echo server). drivers/null serves it; the
# drvtest driver (run by a ktest and by utest) calls it through the
# generated client. Format: see tools/genidl.py.

protocol null 1

1  ping     (u64 value)     -> (u64 value)
2  add      (u32 a, u32 b)  -> (u32 sum)
# A fixed-size byte array each way: the reply is the request reversed.
3  reverse  (u8[16] data)   -> (u8[16] data)
# A handle result (M7): a new VMO of `size` bytes (1..65536) whose first
# byte is `fill`, and its size back. size 0 or too big: ERR_INVALID_ARGS
# and no handle.
4  make_vmo (u32 size, u8 fill) -> (handle vmo, u64 size_back)
