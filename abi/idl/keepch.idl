# keepch: the keep channel (<keep.h>, user/lib/keep.c; docs/HISTORY.md, M11.6):
# how a service that must outlive its process hands the
# kernel objects its clients hold the other end of to its supervisor, the
# keeper, and gets them back in its next instance. Named keepch so its
# stubs (keepch_put) don't take the names of libos's keep_put and
# keep_restore, which wrap them.
#
# One channel, both directions, events only (no call has a reply, the
# order of the messages is the protocol's safety, see <keep.h>): the
# service's end is its startup handle SR_KEEP, the keeper (devmgr's and
# init's, user/lib/supervise.c) holds the other end and is this protocol's
# server.
#
#   service -> keeper:   put (a slot and its handles), drop (a slot)
#   keeper -> successor: restore (whole slots, up to BATCH handles a
#                        message), then one done
#
# A slot is a number the service chooses (an index into its own tables)
# naming up to SLOT_HANDLES handles that come and go together.
#
# The keeper takes channels, VMOs and events only, each able to be
# duplicated, and at most MAX_SLOTS slots and MAX_HANDLES handles for one
# service; a put that breaks a rule is refused whole (its handles closed and
# counted) without telling the service, which finds out at the next restart:
# its slot is not restored. The generated server also drops, closing their
# handles, the messages that break the format: a drop with a handle, a put
# of more than SLOT_HANDLES, a message with a txid (answered
# ERR_INVALID_ARGS, which nobody reads: the service's end is for events).
#
# Reconnect: the keep channel belongs to one instance. When the service
# ends the keeper reads what is still queued on it (the puts and drops the
# dead instance made before it died), closes its end, makes a new channel
# for the next instance (keeper_attach) and sends it the restore. The
# service itself never sees ERR_PEER_CLOSED on a restart; a keeper that
# gives up on a service (keeper_release) closes the channel and the
# service's clients see ERR_PEER_CLOSED. Only a service with a state VMO
# and a supervisor that follows <supervise.h> has one.

protocol keepch 80

# Slots a keeper holds for one service.
const MAX_SLOTS     1024
# Handles a keeper holds for one service, all slots together: room for
# extfs's open files, views, maps, watchers and directory channels (about
# 1,216 at most; user/services/extfs/keeper.c's asserts).
const MAX_HANDLES   2048
# Handles in one slot.
const SLOT_HANDLES  4
# Handles in one restore (a channel message's most).
const BATCH         64

# To the keeper: the service made duplicates of the handles in hs (same
# rights; its own stay its own) and gives them as slot `slot`, replacing
# what the keeper held there. 1 to SLOT_HANDLES of them. `ring`: 0, or
# bits of SIG_USER_ALL the keeper sets on hs[1] (an event with
# RIGHT_SIGNAL: a put that says otherwise is refused) when it closes the
# slot without being told to: it gave the service up (keeper_release, a
# restore that failed) or couldn't hand the slot over. A client waiting
# on that event alone (a watcher channel's bell: an inotify descriptor's
# poll) wakes to find the slot's channel closed (INOTIFY-REVIEW's 7). A
# drop, or a put replacing the slot, rings nothing.
1  put      (u32 slot, u32 ring, handle[<=4] hs) event
# To the keeper: forget slot (close what it held there); a slot it never
# kept is no error.
2  drop     (u32 slot) event
# To the successor: whole slots, their handles in order (slot 0's first):
# slots[i] is the service's slot number, counts[i] (1 to SLOT_HANDLES) how
# many of the handles are its. The sum of the counts is the handle count.
3  restore  -> (u32[<=64] slots, u8[<=64] counts, handle[<=64] hs) event
# To the successor, after the last restore: how many slots and handles
# there were in all.
4  done     -> (u32 slots, u32 handles) event
