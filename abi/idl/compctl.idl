# compctl: the compositor's control channel (user/services/compositor,
# docs/G1-PLAN.md). System powers, not app features: Wayland clients
# never see it. init holds the ADMIN channel the compositor is started
# with, and makes narrower ones with new_client for devmgr (its HID
# drivers' input sources) and for serialin. Format: see tools/genidl.py.
#
# Levels, fixed on a channel when it is made: 0 ADMIN (init's: every
# method), 1 INPUT (devmgr's: add_source only). Any other method on an
# INPUT channel: ERR_ACCESS_DENIED. The desktop's notices are a protocol
# of their own on /svc/notify's channels (abi/idl/notify.idl; review W9:
# its NOTIFY level and methods 7 to 9 went there).
#
# Reconnect: the compositor keeps nothing across a restart. After
# ERR_PEER_CLOSED ask init for a new channel (init restarts the
# compositor and makes the narrower channels again). An input source's
# channel closes with it: a HID driver exits 0 and devmgr binds it again,
# which connects it to the new compositor (serialin likewise, by init);
# keys sent to the old one and not yet taken are lost, and so are the keys
# held down (the new compositor starts with none held, Num Lock on). A
# layout_wait still waiting ends with ERR_PEER_CLOSED: init asks the new
# compositor again, which answers at once if the layout it came back with
# isn't the one init knows (the state it keeps across a restart has every
# screen's layout, a switch the old one hadn't reported yet included:
# review W18), and init saves it.

protocol compctl 32

# 1 (connect_input, a call answering the source's channel): gone (review
# W8), not reused: add_source.

# Blank the screen (on 1): the splash's background over all of it and no
# window drawn, until on 0. Input still goes to the windows. For init's
# reboot by kexec: the screen stays that colour until the next boot's
# splash. ADMIN only.
2  blank          (u8 on) -> ()
# A new channel with less authority: level 1 (INPUT). A caller may only
# make a level above its own: ERR_ACCESS_DENIED otherwise,
# ERR_INVALID_ARGS for a level > 1 (2, NOTIFY, went with the notices to
# notify.idl). At most 8 channels at once: ERR_NO_RESOURCES. ADMIN only.
3  new_client     (u8 level) -> (handle client)
# What the compositor has done, for tests and `ps`: paints and the pixels
# they composed, the last and the worst paint's time (ns); the clients
# connected now, their surfaces and windows; connections taken, refused,
# and gone by why (closed, a protocol error, too slow to read); input
# sources connected now, key presses taken, and those the compositor kept
# for itself (Ctrl+Alt+Del, Alt+Tab and the window keys). ADMIN only.
4  stats          () -> (u64 paints, u64 painted_px, u64 last_paint_ns, u64 worst_paint_ns, u32 clients, u32 surfaces, u32 windows, u64 connected, u64 refused, u64 gone_closed, u64 gone_protocol, u64 gone_slow, u32 sources, u64 keys, u64 reserved_keys)
# The window layout, 0 floating or 1 tiling: every window placed again, as
# the layout key (Super+T) does. For init, which starts the compositor
# before /data is there and sends the saved one (/data/etc/settings'
# display.layout) once it is. ERR_INVALID_ARGS: another value. ADMIN only.
5  set_layout     (u8 layout) -> ()
# Answered when the window layout is no longer `layout` (at once if it
# isn't), with the one it is now: the user switched it, and init saves
# it. One call waits per channel: a second while one waits is
# ERR_BAD_STATE. ADMIN only.
6  layout_wait    (u8 layout) -> (u8 now) later

# 7 (notify), 8 (notify_wait) and 9 (withdraw): gone to notify.idl
# (review W9), not reused.

# A new input source (review W8: an event, so nothing waits and no answer
# comes late): the caller makes a channel, hands one end to the source (a
# HID driver, serialin), which sends the `input` protocol's events on it
# (abi/idl/input.idl), and gives the compositor the other, which serves it.
# At most 16 sources at once: past that the compositor closes the end it
# was given (the source sees its peer close, as on a compositor restart).
# ADMIN and INPUT; on another channel the end is closed.
10 add_source  (handle<channel> source) event
