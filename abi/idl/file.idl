# file: one open file, the channel fs.open returned. Data moves through the
# buffer VMO fs.open returned with it (map it once): read fills it from
# offset 0, write takes what the client put there. Transfers larger than
# the buffer (64 KiB) are split by the client (libos does). Closing the
# channel closes the file (a written file's directory entry is updated
# then, as by sync). Format: see tools/genidl.py.
#
# Restart: fat's restart is not seen: volumes' keeper holds this channel
# and the buffer VMO across fat's death, the successor carries on with
# the file as the last answered request left it (an answered write is
# never lost, synced or not), and the request in progress is finished
# exactly once. ERR_PEER_CLOSED: the mount went (fs.idl says when), or a
# successor couldn't carry on from the dead one's state and started
# fresh (said in the log); the file is closed, and is opened again
# through the mount's `fs` channel.

protocol file 17 kept

# file.map's flags: the file's one shared VMO (read and map only), or a
# VMO of the caller's own for vmo_make_exec_verified.
const MAP_READ  1
const MAP_EXEC  2

# Read up to `length` bytes (<= the buffer's size) at `offset` into the
# buffer; `actual` < length only at the end of the file.
1  read  (u64 offset, u32 length) -> (u32 actual)
# Write `length` bytes from the buffer at `offset` (FS_APPEND: at the end,
# whatever `offset` says); the file grows as needed. Not opened FS_WRITE:
# ERR_ACCESS_DENIED.
2  write  (u64 offset, u32 length) -> (u32 actual)
3  truncate  (u64 size) -> ()
# The file's size now, 1 if a directory (always 0 until directory handles,
# M13), its modification time (that of the last sync or close after a
# write) and its id (fs.stat's).
4  stat  () -> (u64 size, u8 is_dir, u64 mtime, u64 id)
5  sync  () -> ()
# Map the file: a VMO whose pages are the file's, fetched as they are
# touched; `size` is the file's now (the VMO follows a truncate or growth).
# FILE_MAP_READ: the file's one shared VMO, read and map only.
# FILE_MAP_EXEC: a VMO of its own, for vmo_make_exec_verified (the shell).
# A view without the file's read right: ERR_ACCESS_DENIED. A directory:
# ERR_IS_DIR. A service with no pager: ERR_NOT_SUPPORTED (fat answers that
# until it serves pages). Restart: a successor answers its keys' requests.
6  map  (u32 flags) -> (handle<vmo> vmo, u64 size)
