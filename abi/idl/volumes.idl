# volumes: the disks, their filesystem services (bin/fat) and the mounts
# they make (user/services/volumes). init starts it right after devmgr and
# holds its control channel; tests reach it at /svc/volumes (a channel per
# opener: svc.connect, abi/idl/svc.idl, which the control channel answers
# too). Mounts are named by their path: the boot disk's "/esp" (read-only)
# and "/data", another stick's FAT volumes "/usb0", "/usb1", ... (read-only
# until `remount`), and a test disk's "/esp-test", "/data-test",
# "/usb0-test", ...
#
# Supervision of the filesystem services, by the rule of a service that
# outlives its process (<supervise.h>): exit 0 is the end of it; a
# deliberate kill (`kill`) is not counted and is restarted at once; a crash
# or any other exit is counted, the first in a minute restarted at once,
# later ones with backoff (100 ms doubling to 5 s), and the 6th counted
# death in a minute gives up. A restart is the warm spare promoted when one
# waits (one fat started with SR_STANDBY alone, "fat-spare"), else a new
# process; either way on a new `block` channel and the same `fs` channel,
# so it is no change of the mounts.
#
# Reconnect (init's supervision): when volumes ends, every channel it made
# closes: each mount's `fs` channel and everything opened through it, the
# watch channels, the ESP's writable channel. What its filesystem services
# held and had not written is lost (up to their hold's ~1 MiB a mount).
# Open /svc/volumes again (init has the next one's control channel); the
# next volumes mounts what devmgr hands it, and a new watch lists it.

protocol volumes 70

# A mount's service (supervision's `state`).
const SUP_NONE       0
const SUP_RUNNING    1
# died; its restart is due
const SUP_RESTARTING 2
# died too often: no more restarts
const SUP_GAVE_UP    3
# exited 0 by itself
const SUP_FINISHED   4

# A new watch: a channel on which volumes sends `mounts` events (below):
# every mount there is now, then `settled`, then each change. volumes'
# end receives nothing. A watcher that leaves MOUNTS_UNREAD_MAX events
# unread is dropped (its channel closed): it watches again, and gets the
# whole list. ERR_NO_RESOURCES: as many watches as volumes keeps.
1  watch  () -> (handle<channel> events)
# The mount `mount` (another stick's /usbN, or a test disk's /usbN-test)
# writable (1) or read-only (0), answered later (volumes serves its other
# requests meanwhile): its service stops in order (fsctl.stop:
# its files closed, everything flushed, the volume clean) and starts again
# on a `block` channel opened the new way (read-only: the disk itself
# refuses every write). The mount's channel is a new one (`unmounted`,
# then `mounted` once its volume is mounted again), and files open on the
# old one fail ERR_PEER_CLOSED. Nothing is ever formatted, in either mode.
# Answered once the new instance runs; OK at once if it is that way
# already. ERR_NOT_FOUND: no such mount, or not one that can be asked for
# (/esp, /data: they are what they are); ERR_BAD_STATE: its service isn't
# serving, or another remount or a release of it is under way;
# ERR_INVALID_ARGS: writable past 1.
2  remount  (str[<=15] mount, u8 writable) -> () later
# Kill the mount's filesystem service (a deliberate kill: not counted,
# restarted at once, the warm spare promoted; its clients see nothing but
# the time it took). `mount` may also be the service's process name:
# "fat-data" (whatever its process is called now), or "fat-spare", the
# first service whose process is the warm spare promoted (a promoted
# spare keeps that name). Answered once it is dead, with the koid of the
# process killed; while its restart is under way, once the new instance
# runs (then that one is killed). ERR_NOT_FOUND: no such mount, or no
# instance runs (its restart is due later); ERR_BAD_STATE: it is being
# stopped in order (a remount, the ESP made writable, a release).
3  kill  (str[<=15] mount) -> (u64 koid) later
# The mount's service: its state (SUP_*), restarts since boot, the last
# backoff in ms, the restarts that promoted the warm spare, and 1 while a
# spare waits. ERR_NOT_FOUND: no such mount.
4  supervision  (str[<=15] mount) -> (u32 state, u32 restarts, u32 backoff_ms, u32 promoted, u8 spare_waits)
# A software disk for tests: `storage` speaks storage.idl, and volumes
# treats it like a usb-storage disk (the same questions, the same boot-disk
# check, the same supervision of its services), with one difference: its
# mounts are the /...-test ones, and "the boot disk" is counted among test
# disks only, so a test never takes /data away. Gone once the channel's
# server end closes. ERR_NO_RESOURCES: too many disks.
5  test_disk  (handle<channel> storage) -> (u32 id)
# Disk `id` let go (a test disk's id from test_disk, or devmgr's from
# disks.attach): each of its mounts stops in order (its files closed, the
# volume clean) and goes, and the disk is not mounted again until it comes
# back (a new disks.attach). For a test that drives the disk itself
# (usbtest asks this, then devmgr's release). Answered once all have
# stopped. ERR_NOT_FOUND: no such disk.
6  release_disk  (u32 id) -> () later
# Every writable mount (fs.sync each), answered once all have answered,
# with the first failure. Each is given 5 s.
7  sync  () -> () later
# Stop, for a reboot: every writable mount synced, then every filesystem
# service stopped (and the warm spare); answered then, and volumes exits
# (0 if nothing went wrong while it ran). Requests after it: the channel
# closes.
8  stop  () -> () later
# The server end of a new disks channel (devmgr was started again, and
# init made the pair). The disks of the old one are forgotten, without
# notices.
9  set_disks  (handle<channel> disks) -> ()
# A new channel that speaks `voldisks` (below) alone: the list of the
# disks and their partitions, and the two questions about a whole disk
# that need no write (digest, health). init hands one to the shell
# (initctl.disks) for `disks` and `disk`; nothing on it can change a
# mount. ERR_NO_RESOURCES: as many channels as volumes keeps.
10 list_channel  () -> (handle<channel> list)

# volesp: the boot disk's ESP made writable, for init's stick write
# (`update -w`, user/services/init/espwrite.c) alone: init made this
# channel when it started volumes, and gives it to nobody; volumes serves
# nothing else on it, and nothing of this on any other channel. While
# writable, /esp is no mount (every watch is told `unmounted`), so no
# namespace holds the writable channel.
#
# Reconnect: ERR_PEER_CLOSED: volumes ended; the ESP is read-only again
# with the next volumes, and init has a new ESP channel for it.

protocol volesp 71

# The ESP's service stops in order and starts again on a `block` channel
# opened read-write; `fs` is a channel to it, the caller's alone. Called
# while it is writable already: another handle to the same channel. A
# crash meanwhile restarts it writable; a pulled stick ends it (the
# stick's next mount is read-only). ERR_NOT_FOUND: no boot disk with an
# ESP service; ERR_BAD_STATE: it isn't serving.
1  open_writable  () -> (handle<channel> fs) later
# Back to read-only: it stops in order (everything on the stick, the
# volume clean), starts again read-only, and /esp is a mount again (a new
# channel). OK at once if it is read-only already.
2  close_writable  () -> () later

# disks: the disks devmgr's drivers serve, told to volumes (devmgr's
# user/services/devmgr/disks.c sends, volumes serves). init makes a new
# pair whenever devmgr or volumes starts, and hands one end to each
# (devmgr's SET_VOLUMES; volumes' startup role or `volumes.set_disks`).
# One way: devmgr waits for nothing.
#
# Reconnect: when the channel's peer closes, the other side drops it and
# waits for the next: devmgr announces every disk again on a new channel;
# volumes forgets every disk the old one announced, without notices.

protocol disks 72

# Buses (attach's `bus`).
const BUS_USB 1
const BUS_NVME 2

# A disk is there: its driver runs. `storage` is a channel of volumes'
# own (devmgr asked the driver's DR_SERVE for it: svc.connect). `id` names
# the disk while the device is there (USB: usb-bus's device id; a later
# bus picks ids in its own range, never with the top bit, which test
# disks use). A driver started again after a crash is announced again
# with the same id. ERR_PEER_CLOSED on `storage` alone means the driver
# ended, not that the device went.
1  attach  (u32 id, u8 bus, handle<channel> storage) event
# The device is gone (unplugged, or its bus driver ended): the disk will
# not come back under this id.
2  gone  (u32 id) event

# mounts: what volumes sends on a watch channel (volumes.watch). The
# events of one change all carry its generation, and `settled` ends it;
# a new watch gets every mount there is with the current generation, then
# `settled`. A generation is never 0, and a volumes that init started
# again counts from somewhere else (the clock), so it is never taken for
# the dead one's.
#
# A mount's channel stays the same across its service's restarts (they
# are no change): a new channel comes with `unmounted` then `mounted` (a
# remount, the ESP made writable and back, a service started again after
# it was given up on). Init puts each in its namespace (/boot excepted)
# and tells its followers at `settled`.
#
# Reconnect: ERR_PEER_CLOSED: volumes ended (every mount went with it), or
# this watcher fell MOUNTS_UNREAD_MAX events behind; watch again.

protocol mounts 73

# `mounted`'s flags.
const READ_ONLY 1
# a test disk's: nobody's namespace wants it
const TEST      2
# events a watcher may leave unread before it is dropped
const UNREAD_MAX 256

# A mount, and its `fs` channel (abi/idl/fs.idl): a duplicate of volumes'
# client end, the watcher's to keep or close.
1  mounted  -> (str[<=15] path, u32 generation, u8 flags, handle<channel> fs) event
# The mount `path` is gone: its channel is closed or about to be.
2  unmounted  -> (str[<=15] path, u32 generation) event
# The list is whole as of `generation`: tell the namespaces now.
3  settled  -> (u32 generation) event

# voldisks: what the shell's `disks` and `disk` ask (M12.7 stage 1). The
# channel is read-only by construction: it can list, hash and ask for a
# drive's health, never mount, remount, kill or attach anything. volumes
# keeps what it asked each driver when the disk came (storage.info,
# .partition, and for an NVMe drive .ident) and answers from that; the
# digest and the health log are asked of the driver each time (a task
# answers later, volumes serves its other requests meanwhile). A test
# disk (volumes.test_disk) is not listed.
#
# Reconnect: ERR_PEER_CLOSED: volumes ended; ask init for a new channel
# (initctl.disks).

protocol voldisks 74

# A disk's `kind`: the Jam OS layout (an ESP then a FAT32 data partition on
# an MBR disk, or on a drive the GPT mark: GPT with exactly two partitions,
# the ESP's type named "Jam OS ESP" and Jam OS's data type named "Jam OS
# data", checked by volumes' own code, not the driver's), a disk in which no
# partition table was found (blank, or in a form volumes does not read: the
# driver's blank rule is stricter, and decides), or anything else. Only a
# Jam OS disk may ever be written.
const KIND_OTHER    0
const KIND_NO_TABLE 1
const KIND_JAMOS    2

# A partition's `fs`: what became of its filesystem service.
# its type says it holds no FAT volume: never started
const FS_NONE        0
# mounted at `mount`
const FS_MOUNTED     1
# a FAT type whose service has not started or not found its volume yet
const FS_WAITING     2
# started and found no FAT volume: left alone, nothing written
const FS_NO_FAT      3
# a FAT type on a disk whose block size is not 512: fat reads 512 only
const FS_BLOCK_SIZE  4
# not looked at: more partitions than volumes keeps (MAX_PARTS)
const FS_UNLISTED    5

# Disk number `index` (0-based, in the order they came; the real ones, not
# a test disk). `id` is the disk's (disks.attach's; digest and partition
# name a disk by it), `name` what the shell calls it ("nvme0", "usb0":
# numbered per bus in the order they came, and again if one goes), `bus`
# DISKS_BUS_*. `ready` 0: its driver has not answered yet (or has not
# answered at all, or is restarting): everything else but id, bus and name is
# zero. `kind` KIND_*, `scheme` storage.idl's SCHEME_*, `partitions` how
# many the driver lists (more than are given by `partition` when it is
# past MAX_PARTS), `read_only` 1: volumes opens none of its partitions
# writable (every NVMe drive that is not a Jam OS disk by volumes' own
# check). `model`, `serial` and `firmware`
# are the drive's own (storage.ident; a stick has the INQUIRY's vendor and
# product in `model` and the others empty). Past the last:
# ERR_OUT_OF_RANGE.
1  disk  (u32 index) -> (u32 id, u8 bus, u8 ready, u8 kind, u8 scheme, u8 read_only, u32 block_size, u64 blocks, u32 partitions, str[<=8] name, str[<=40] model, str[<=20] serial, str[<=8] firmware) idempotent
# Partition `index` (0-based, in table order) of disk `id`: storage.partition's
# MBR type byte, GPT type GUID, first block, length and GPT name, then `fs`
# (FS_*) and, mounted, its `mount` ("/nvme0"; empty otherwise). ERR_NOT_FOUND:
# no such disk; ERR_OUT_OF_RANGE: past the last partition volumes keeps.
2  partition  (u32 id, u32 index) -> (u8 mbr_type, u8[16] type_guid, u64 start, u64 blocks, u8 fs, str[<=108] label, str[<=15] mount) idempotent
# The SHA-256 of `count` blocks from `lba` of disk `id`, read in its driver
# (storage.digest; its errors come back as they are). ERR_NOT_FOUND: no
# such disk; ERR_BAD_STATE: its driver is not there (restarting).
3  digest  (u32 id, u64 lba, u64 count) -> (u8[32] sha256) later
# The drive's health log (storage.health, NVMe's SMART page): the counters,
# percentage used and the critical warning. Errors as `digest`'s.
4  health  (u32 id) -> (u64 units_read, u64 units_written, u64 host_reads, u64 host_writes, u64 power_cycles, u64 unsafe_shutdowns, u8 percent_used, u8 critical) later

# What `disk prepare` would do to a disk (prepare_check's `plan`), decided
# by volumes' checks and the driver's mode (storage.mode: the driver's
# empty rules decide whether a drive is empty).
# empty: Jam OS's table, then both partitions formatted
const PLAN_TABLE  0
# a Jam OS disk a prepare was cut short on: its partitions with no volume formatted
const PLAN_FINISH 1
# not empty: ERASED, everything on it lost (its read-only mounts go first);
# volinstall.prepare needs the owner's confirmation
const PLAN_ERASE  2
# Why a disk can't be prepared at all (prepare_check's `refused`).
const REFUSED_NONE       0
# the disk Jam OS booted from
const REFUSED_BOOT_DISK  1
# a volume on it is mounted read-write
const REFUSED_IN_USE     2
# the `diskro` word: every internal drive is read-only
const REFUSED_READ_ONLY  3
# a Jam OS disk with both partitions mounted: nothing to do
const REFUSED_JAMOS      4
# not an NVMe drive
const REFUSED_NOT_NVME   5
# blocks that aren't 512 bytes: fat reads no other
const REFUSED_BLOCK_SIZE 6
# under about 580 MiB
const REFUSED_TOO_SMALL  7
# its driver couldn't read its partition table: it is never erased
const REFUSED_UNREADABLE 8

# What `disk prepare` of disk `id` would do (PLAN_*), or why it can't be
# prepared (`refused`, REFUSED_*; REFUSED_NONE: it can), asked before the
# owner is asked anything. Nothing changes: volumes looks at the disk and
# its mounts and asks the driver its mode (storage.mode). ERR_NOT_FOUND: no
# such disk; ERR_BAD_STATE: its driver is not there, or it is being
# prepared, released or still starting a mount (ask again in a moment); the
# driver's errors as they come.
5  prepare_check  (u32 id) -> (u8 plan, u8 refused) later

# volinstall: making a disk Jam OS's (M12.7 stage 2; stage 3's installer
# adds its methods). Like `volesp`, init's alone: init made this channel when
# it started volumes (the startup role VOLUMES_SR_INSTALL), holds the client
# end and gives it to nobody; volumes serves nothing else on it, and
# nothing of this on any other channel. The shell reaches it through
# initctl.prepare_disk, after the owner has typed the last four characters
# of the drive's serial number (and `erase`, for a drive that isn't empty).
#
# Reconnect: ERR_PEER_CLOSED: volumes ended; init has a new channel for the
# next one, and the request is asked again by its caller.

protocol volinstall 75

# Disk `id` (voldisks' ids) made a Jam OS disk, then its two partitions
# formatted and mounted read-only (/nvmeN, /nvmeM: `mount -w` makes them
# writable). What is done is voldisks.prepare_check's plan, checked again
# here:
#   - PLAN_TABLE, an empty drive (the driver's empty rules): Jam OS's
#     partition table: volumes makes three random GUIDs and asks the
#     driver's storage.create_table, then reads the disk again and starts a
#     filesystem service on each partition with the one right to format
#     (fat formats a partition whose first sector holds no boot signature,
#     and no other);
#   - PLAN_ERASE, a drive that isn't empty: only when `tail` is the end of
#     the drive's serial number as the owner typed it (its last 4
#     characters, the whole serial if shorter, in any case) and `word` is
#     "erase" (checked here, then by the driver again, which gets both);
#     then its read-only mounts go, and the same as PLAN_TABLE, the driver
#     zeroing where the two partitions start before it writes the table;
#   - PLAN_FINISH, a Jam OS disk (volumes' own mark check) whose
#     partitions are not both mounted: the format and mount of the ones
#     that are not (the next run of a prepare that was cut short).
# `tail` and `word` aren't looked at for the other plans. The formatted
# partitions are then opened read-only again (their services stopped in
# order, started again). Answered once both partitions are mounted.
# ERR_NOT_FOUND: no such disk; ERR_NOT_SUPPORTED: not an NVMe drive, or not
# 512-byte blocks; ERR_BAD_STATE: its driver is not there, or it is being
# prepared, released or still starting a mount; ERR_ACCESS_DENIED: the boot
# disk, read-only (the `diskro` word), or not empty and not confirmed (no
# `tail` and `word`, or wrong ones: nothing is written, nothing unmounted);
# ERR_BUSY: a volume on it is mounted read-write; ERR_ALREADY_EXISTS: a Jam
# OS disk with both partitions mounted already; ERR_NO_SPACE: too small
# (under about 580 MiB); ERR_IO: its table couldn't be read, or a write or
# a format failed (the table or a partition may be half done: ask again);
# ERR_TIMED_OUT: not mounted within the time given (10 minutes).
1  prepare  (u32 id, str[<=20] tail, str[<=8] word) -> () later
