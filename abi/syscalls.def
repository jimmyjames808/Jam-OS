# Jam OS system calls: the one table the numbers, the user wrappers and the
# kernel dispatch are generated from (tools/gensyscalls.py; `make syscalls`
# regenerates, and every build fails if the committed output is stale).
#
# One call per line:
#
#     <nr>  <name>  <return>  <arguments>
#
# nr        decimal, unique. Gaps are fine (they group the calls); an unused
#           number fails with ERR_NOT_SUPPORTED. 0 is never used, so a
#           zeroed rax can't reach a real call.
# name      C identifier. User code calls jam_<name>(), the kernel
#           implements sysc_<name>() (a weak ERR_NOT_SUPPORTED default is
#           generated until the real one exists).
# return    status    status_t: OK or a negative ERR_*
#           i64       a value; negative means an ERR_* code
#           noreturn  never returns on success (the user wrapper traps
#                     with ud2 if it ever does)
# arguments void, or up to six C declarations as user code sees them,
#           comma-separated ("handle_t h, const void *buf, uint64_t len").
#           Scalars: handle_t rights_t signals_t uint32_t int32_t uint64_t
#           int64_t. Anything with a '*' is a user pointer: the kernel side
#           gets it as a uint64_t and may only touch it through
#           copy_from_user / copy_to_user.
#           Or "@<struct>": the call takes one pointer to struct <struct>
#           (defined in <jam/abi.h>); the dispatcher copies the struct into
#           the kernel and sysc_<name> gets a const kernel pointer to that
#           copy. This is how calls with more than six arguments are made.
#
# Register convention (jam/syscall.h): number in rax, arguments in rdi rsi
# rdx r10 r8 r9, result in rax. Arguments narrower than 64 bits are
# truncated to their type, as in a C call.
#
# Lengths (M12): a length past a call's limit (the limits are in
# <jam/abi.h>) is ERR_OUT_OF_RANGE, with nothing cut and nothing done.

# basics --------------------------------------------------------------------
# Print len bytes (at most DEBUG_WRITE_MAX, 4096) to the kernel log as
# "[name] line" lines.
1   debug_write       status    const char *buf, uint64_t len
2   process_exit      noreturn  int64_t code
3   thread_exit       noreturn  void
4   clock_get         i64       void
# Sleep until the uptime clock reaches deadline_ns (a deadline, as every
# call takes: M12's rule for time). Named nanosleep until M12, the same
# number and arguments.
5   sleep_until       status    uint64_t deadline_ns
# debug_write, and the line also goes into the RESULTS box at the end of the
# boot (at most a few dozen lines from all processes together).
6   debug_report      status    const char *buf, uint64_t len

# handles -------------------------------------------------------------------
10  handle_close      status    handle_t h
11  handle_duplicate  status    handle_t h, rights_t rights, handle_t *out
# handle_replace: *out gets h's object with `rights` (a subset of h's, or
# RIGHT_SAME), and h is gone whatever the status: rights it hasn't
# (ERR_INVALID_ARGS) close it, as a send's refused list does.
12  handle_replace   status    handle_t h, rights_t rights, handle_t *out
# What h names (struct handle_info, <jam/abi.h>): the object's type
# (OBJ_*), the handle's rights, the object's koid, a related koid (a
# channel end's peer, a thread's process, a process's job), and for a
# channel end what waits on it and what it wrote that waits unread at its
# peer. No right needed: it says only what trying calls would. ERR_BAD_HANDLE;
# ERR_INVALID_ARGS for a bad out.
13  handle_info       status    handle_t h, struct handle_info *out

# waiting and signals -------------------------------------------------------
# The wait rule: a wait holds the object it waits on, so another thread
# closing the handle doesn't end it (object_wait_one, port_wait: it ends
# at its deadline, a match, or the thread's kill, ERR_CANCELED). Only a
# channel end's own waits (channel_call, channel_read's wait in
# channel_reply_wait) end when that end closes (ERR_CANCELED).
# thread_interrupt (88) ends object_wait_one, port_wait, futex_wait and
# sleep_until with ERR_INTERRUPTED, and no other wait.
16  object_wait_one   status    handle_t h, signals_t mask, uint64_t deadline_ns, signals_t *observed
# (Number 17 was object_signal, user bits on any object, until M12:
# retired. An event's user bits are event_signal's.)

# channels ------------------------------------------------------------------
# The handles a send is given (channel_write's and channel_write_rights's
# list, channel_call's request handles, channel_reply_wait's reply
# handles) leave the caller's table whatever the status, once the kernel
# has read the list: sent with the message, or closed. A refused list too
# (a bad value, a handle without RIGHT_TRANSFER, the channel's own end).
# The list is read first: only a list it can't read (more than
# CHANNEL_MAX_HANDLES, no buffer for it, a fault) leaves them; any other
# argument error (a size, a flag) closes them too. A caller that may try
# again duplicates first.
# process_start's arg0 follows the same rule.
# A message is charged to the writer's job (JOB_LIMIT_MSG_BYTES: its bytes,
# plus JOB_OBJECT_BYTES per handle; ERR_NO_MEMORY over the limit) until it
# is read or dropped (the reading end closes), also after the writer has
# closed its end: a close frees nothing of the writer's quota.
20  channel_create    status    handle_t *a, handle_t *b
# channel_write: nbytes (at most CHANNEL_MAX_BYTES; the first 4 bytes of a
# message are its txid, by convention) and nhandles (at most
# CHANNEL_MAX_HANDLES, each needing RIGHT_TRANSFER) go to the peer's queue,
# or straight to the channel_call waiting there for that txid. Needs
# RIGHT_WRITE on h. ERR_SHOULD_WAIT: CHANNEL_MAX_QUEUED messages wait
# already; ERR_PEER_CLOSED: the peer is gone; ERR_OUT_OF_RANGE: past a
# limit; ERR_NOT_SUPPORTED: a handle the cycle rule refuses (the channel's
# own end, its peer, an end whose queue holds a channel end) or a peer
# marked CHANNEL_NO_HANDLES.
21  channel_write     status    handle_t h, const void *bytes, uint32_t nbytes, const handle_t *handles, uint32_t nhandles
# channel_read (struct channel_read_args, <jam/abi.h>): the oldest message
# into rd_bytes and rd_handles, its sizes into rd_actual and rd_hactual.
# Needs RIGHT_READ. Never waits: ERR_SHOULD_WAIT if nothing is queued,
# ERR_PEER_CLOSED if nothing is queued and the peer is gone.
# ERR_BUFFER_TOO_SMALL (the sizes are still written) leaves the message
# queued. A fault writing the buffers loses the message, its handles
# closed (ERR_INVALID_ARGS).
22  channel_read      status    @channel_read_args
# channel_call (struct channel_call_args): the request, its first 4 bytes
# replaced by a txid of the kernel's (CHANNEL_TXID_KERNEL set, the rest a
# counter of the channel pair's), is written as channel_write does; then
# the call waits for the reply with that txid, which only this thread gets
# (never channel_read), until deadline_ns (ERR_TIMED_OUT; with
# CHANNEL_CALL_TIMEOUT in flags it is a timeout from the kernel's own
# clock). Needs RIGHT_WRITE and RIGHT_READ on h. wr_len is at least 4.
# ERR_PEER_CLOSED: the peer closed; ERR_CANCELED: this end was closed, or
# the thread killed; ERR_BUFFER_TOO_SMALL: the reply didn't fit (its sizes
# are written, the reply and its handles dropped).
23  channel_call      status    @channel_call_args
# A server's reply and its wait for the next request, in one call (struct
# channel_reply_wait_args, <jam/abi.h>). First the reply: a channel_write
# of wr_bytes and wr_handles on h (HANDLE_INVALID: none, a server's first call),
# which goes to the channel_call waiting for its txid on the peer,
# whichever thread or process holding h sends it. Once it went out, 1
# goes into *mark (8 bytes), before anything else. Then the request: with `wait` a channel end, its next
# message read straight into rd_bytes and rd_handles (the sizes as channel_read
# gives them), waiting for one if none is queued; with a port, its next
# packet into *packet (the server reads the channel it names). Needs
# RIGHT_WRITE on h and RIGHT_READ on wait (one lookup when they are the
# same handle). Errors in the arguments (flags, reserved, sizes, handles,
# rights, types, the other form's fields) come before anything is sent.
# A reply that fails with ERR_PEER_CLOSED (its caller's end is gone) is
# no reason not to wait; any other reply error ends the call there with
# that error, nothing read. So *reply_status neither OK nor
# ERR_PEER_CLOSED: the reply failed; otherwise the result is the wait's:
# as channel_read's (ERR_BUFFER_TOO_SMALL leaves the message queued) or
# port_wait's, ERR_TIMED_OUT, ERR_CANCELED (`wait`'s channel end closed
# by another thread, as for channel_call), ERR_PEER_CLOSED (nothing
# queued, the peer gone). *reply_status is written as the call returns,
# with the sizes (after the request's bytes and handles), in one copy
# when the three follow each other in memory; a fault there loses the
# request, as channel_read's. A fault writing the mark ends the call
# after the reply (ERR_INVALID_ARGS), nothing read.
24  channel_reply_wait status   @channel_reply_wait_args
# Mark the end h (needs RIGHT_READ): CHANNEL_NO_HANDLES, it receives no
# handles from now on. A message carrying handles to it is refused
# (ERR_NOT_SUPPORTED, its handles closed as every refused send's), so its
# queue never holds a channel end and the end can always be sent on (a
# kept server end: devmgr's fs channel, init's /svc ends). One-way: a mark
# never comes off. ERR_BAD_STATE if a message carrying handles is queued
# there already, or if h is not the end's only handle (a duplicate
# anywhere, or one in a message): only its sole holder may mark it, since
# the mark stops handle-carrying replies to every holder of a shared end;
# ERR_INVALID_ARGS for any other bit.
25  channel_set_flags status    handle_t h, uint32_t flags
# Withdraw what the end h wrote that its peer hasn't read (needs
# RIGHT_WRITE): every message queued at the peer is dropped, its charge
# refunded to its writer's job, the handles it carries closed; what a
# reader has taken or been handed is not touched. For a server that gives
# up on a client that doesn't read: withdraw, write one last small
# message if it wants (an error), close, and nothing but that message
# stays charged to it while the client keeps its end. Returns how many
# were dropped (0 also once the peer has closed: its close dropped them).
# ERR_BAD_STATE if h is not the end's only handle (on a shared end the
# messages may be any holder's).
26  channel_withdraw  i64       handle_t h

# events and timers ---------------------------------------------------------
30  event_create      status    handle_t *out
31  event_signal      status    handle_t h, signals_t clear, signals_t set
32  timer_create      status    handle_t *out
33  timer_set         status    handle_t h, uint64_t deadline_ns
34  timer_cancel      status    handle_t h

# ports ---------------------------------------------------------------------
# A binding (port_bind) lasts until port_unbind, the port's end, its
# packet read (PORT_BIND_ONCE), or the moment its object has no handle
# left anywhere (in any table or message): nothing could unbind it then.
# A packet it queued stays. While other handles to the object exist, the
# binding is its binder's to unbind.
40  port_create       status    handle_t *out
41  port_bind         status    handle_t port, handle_t obj, uint64_t key, signals_t mask, uint32_t flags
42  port_unbind       status    handle_t port, handle_t obj, uint64_t key
# port_queue: a PORT_PACKET_USER packet with pkt's key and user.data; its
# type and status are the kernel's (status OK: ERR_CANCELED is a binding's).
43  port_queue        status    handle_t port, const struct port_packet *pkt
44  port_wait         status    handle_t port, uint64_t deadline_ns, struct port_packet *out

# VMOs ----------------------------------------------------------------------
# vmo_create: a VMO of size bytes (rounded up to pages; VMO_MAX_SIZE at
# most, ERR_OUT_OF_RANGE past it), its pages charged to the creator's job.
# flags: 0 or VMO_KEEP_PAGES (<jam/abi.h>): every page committed at
# creation and charged then (ERR_NO_MEMORY, no VMO, if the job can't pay
# for all of them), and none ever leaves: vmo_decommit and a shrinking
# vmo_set_size are ERR_BAD_STATE for every handle, a growing vmo_set_size
# commits the new pages before it returns (ERR_NO_MEMORY with the size
# unchanged if it can't). Any other bit is ERR_INVALID_ARGS: contiguous and
# below-4-GiB memory is dma_vmo_create's. No VMO has a clone or
# copy-on-write child. (Number 50 was vmo_create with a dma_cap argument
# until M12: retired.)
58  vmo_create        status    uint64_t size, uint32_t flags, handle_t *out
51  vmo_read          status    handle_t h, uint64_t offset, void *buf, uint64_t len
52  vmo_write         status    handle_t h, uint64_t offset, const void *buf, uint64_t len
53  vmo_get_size      status    handle_t h, uint64_t *size
54  vmo_set_size      status    handle_t h, uint64_t size
55  vmo_commit        status    handle_t h, uint64_t offset, uint64_t len
56  vmo_decommit      status    handle_t h, uint64_t offset, uint64_t len
# vmo_make_exec: *out gets vmo's handle again with RIGHT_EXEC and without
# RIGHT_WRITE, so its code can be mapped executable; vmo's handle is gone
# whatever the status (closed on any error, as a send's handles). Needs
# RIGHT_ROOT_VMEX on root (only init and the shell: a program from /data,
# docs/history/M8.6-SVC.md), RIGHT_READ and RIGHT_MAP on vmo, and vmo
# must be a paged VMO with that one handle, no mapping or pin anywhere
# and no write running (ERR_BAD_STATE otherwise). The VMO is sealed: every later write,
# resize, commit, decommit, writable mapping or pin is ERR_BAD_STATE, even
# one from a call that started before this one.
57  vmo_make_exec     status    handle_t vmo, handle_t root, handle_t *out

# address spaces (flags: VMAR_READ/WRITE/EXEC/FIXED) --------------------------
# vmar_map also takes VMAR_KEPT_ONLY (bit 4): only a VMO_KEEP_PAGES VMO
# (ERR_NOT_SUPPORTED for another VMO), only VMAR_READ (ERR_INVALID_ARGS
# for write or exec), and every page-table entry is filled before the call
# returns, the tables charged to the mapper's job then (ERR_NO_MEMORY,
# nothing mapped), so no access through the mapping ever faults, whatever
# the VMO's other holders do. vmar_protect refuses to change such a mapping
# (ERR_ACCESS_DENIED); a VMO grown later is mapped again for its new pages.
# vmar_map also takes VMAR_REPLACE (bit 5), with VMAR_FIXED and without
# VMAR_KEPT_ONLY: what the range overlaps is unmapped and the new mapping
# made in one step, so another thread never finds the range unmapped
# (MAP_FIXED); on any error nothing changed.
60  vmar_map          status    handle_t vmar, handle_t vmo, uint64_t vmo_off, uint64_t len, uint32_t flags, uint64_t *addr
61  vmar_unmap        status    handle_t vmar, uint64_t addr, uint64_t len
62  vmar_protect      status    handle_t vmar, uint64_t addr, uint64_t len, uint32_t flags

# processes, threads, jobs --------------------------------------------------
# process_start moves `arg0` (a handle in the caller's table, usually the
# startup channel) into the new process and starts `thread` there with
# rdi = its new handle value, rsi = arg1, and FS base 0 (the program sets
# its own: thread_set_fs_base). An entry at or past the user range's top
# (0x7fffffffe000) is ERR_INVALID_ARGS, nothing started. arg0 leaves the
# caller's table whatever the status (closed if the start fails), as a
# send's handles.
# process_create's and thread_create's names: at most PROCESS_NAME_MAX
# (31) bytes, else ERR_OUT_OF_RANGE (libos cuts a name to fit first).
70  process_create   status    handle_t job, const char *name, uint64_t name_len, uint32_t flags, handle_t *proc_out, handle_t *vmar_out
71  process_start     status    handle_t proc, handle_t thread, uint64_t entry, uint64_t stack, handle_t arg0, uint64_t arg1
72  process_kill      status    handle_t proc
73  thread_create     status    handle_t proc, const char *name, uint64_t name_len, uint32_t flags, handle_t *out
# thread_start: as process_start's thread (rdi = arg0, rsi = arg1), with
# its FS base (thread-local storage) fs_base; an entry or fs_base at or past
# the user range's top is ERR_INVALID_ARGS, nothing started. (Number 74
# was thread_start without its FS base until M12: retired.)
83  thread_start      status    handle_t thread, uint64_t entry, uint64_t stack, uint64_t arg0, uint64_t arg1, uint64_t fs_base
75  job_create        status    handle_t parent, uint32_t flags, handle_t *out
76  job_set_limit     status    handle_t job, uint32_t kind, uint64_t value
77  job_get_info      status    handle_t job, struct job_info *out
78  process_get_info  status    handle_t proc, struct process_info *out
79  thread_set_priority status  handle_t thread, int32_t prio
# Kill every process in the job and in all jobs below it (needs
# RIGHT_MANAGE); returns once they are all dead. The jobs take no new
# processes or child jobs afterwards.
80  job_kill          status    handle_t job

# threads: thread-local storage, futexes, yield -----------------------------
# The calling thread's FS base (its thread-local storage pointer, musl's
# __set_thread_area), from the return on; kept across every switch and
# move to another CPU. GS stays 0. ERR_INVALID_ARGS at or past the user
# range's top (0x7fffffffe000). A thread that loads a selector into FS
# itself has an undefined base until it calls this again.
81  thread_set_fs_base status   uint64_t base
# Give up the CPU to a ready thread of the same or a higher priority, if
# there is one on this CPU (sched_yield); OK.
82  thread_yield      status    void
# Futexes: a wait on a 32-bit word of the caller's own
# memory, named by the process and the word's address (private: threads
# of one process meet there). flags: 0 (reserved for a shared kind).
# futex_wait sleeps if *addr == expected when the kernel reads it (after
# queueing the caller, so a futex_wake that follows a store to the word is
# never lost) until a futex_wake picks it (OK; spurious wakes are allowed:
# check the word again) or deadline_ns (ERR_TIMED_OUT); ERR_BAD_STATE at
# once if *addr != expected; ERR_INVALID_ARGS for flags, an address that
# isn't 4-aligned, outside user space or not readable.
85  futex_wait        status    const uint32_t *addr, uint32_t expected, uint64_t deadline_ns, uint32_t flags
# Wake up to count threads waiting on addr, oldest first: how many.
86  futex_wake        i64       const uint32_t *addr, uint32_t count, uint32_t flags
# Wake up to `wake` threads waiting on addr, then move up to `requeue` of
# the others to wait on addr2 (a futex_wake there wakes them): how many it
# woke and moved together (musl's condition variables).
87  futex_requeue     i64       const uint32_t *addr, uint32_t wake, const uint32_t *addr2, uint32_t requeue, uint32_t flags

# threads and processes for POSIX: ids, the tid word, interrupts, CPU time
# (and, numbered with the system information, what any program may know).
# Ids: process_info.pid, thread_info.tid (<jam/abi.h>, IDS_MAX).
# The calling thread's tid word (Linux's set_tid_address, musl's
# pthread_join): when the thread ends while its process runs, after its
# last instruction in user mode, the kernel stores 0 at addr and wakes
# every futex_wait on it, so a joiner may unmap the thread's stack the
# moment it sees 0. addr 0: none. Returns the thread's tid.
# ERR_INVALID_ARGS for an address that isn't 4-aligned or in user space
# (not checked further: a store that faults is skipped, with no wake).
84  thread_set_tid_word i64     uint32_t *addr
# End the thread's current interruptible wait (object_wait_one, port_wait,
# futex_wait, sleep_until) with ERR_INTERRUPTED; one not in such a wait
# ends its next one at once. Latched, not counted: any number before a
# wait takes it end that one wait. A wait whose condition is met returns
# its result and leaves the interrupt for the next. No other call is ever
# ended by it (channel_call, channel_reply_wait, ...). Needs RIGHT_SIGNAL
# on the thread; ERR_BAD_STATE if it hasn't started or has left.
88  thread_interrupt  status    handle_t thread
# A thread's tid, its process's koid and pid, state, CPU time and
# priority (struct thread_info); needs RIGHT_INSPECT.
89  thread_get_info   status    handle_t thread, struct thread_info *out
# struct sys_public_info: the version, the machine, the CPUs online, the
# memory and the page size (uname, sysconf). No handle or right needed.
136 sys_public_info   status    struct sys_public_info *out

# hardware ------------------------------------------------------------------
# Resources (RES_* in <jam/abi.h>): a slice must lie inside its parent,
# which needs RIGHT_SLICE.
90  resource_create   status    handle_t parent, uint32_t kind, uint64_t base, uint64_t size, handle_t *out
# PCI (needs RES_PCI): function `index` (0 ..), ERR_OUT_OF_RANGE past the last.
91  pci_enum          status    handle_t pci, uint32_t index, struct pci_dev_info *out
92  pci_device_open   status    handle_t pci, uint32_t index, handle_t *out
# One function (RES_PCI_DEV). Config access is filtered: BARs, the command
# register's decode/bus-master bits and the MSI/MSI-X capabilities are
# refused (ERR_ACCESS_DENIED); width 1, 2 or 4.
93  pci_config_read   status    handle_t dev, uint32_t offset, uint32_t width, uint32_t *value
94  pci_config_write  status    handle_t dev, uint32_t offset, uint32_t width, uint32_t value
95  pci_bar_resource  status    handle_t dev, uint32_t bar, handle_t *out
# pci_bus_master_off (104, below) turns a function's bus mastering off.
# (Number 96 was pci_bus_master, with an `enable` argument that could only
# be 0, until M12: retired.)
# Interrupt objects: MSI or MSI-X (flags IRQ_MSIX) vector `index` of the
# function; bind to a port PERSISTENT for SIG_INTERRUPT; ack re-arms.
97  interrupt_create_msi status handle_t dev, uint32_t index, uint32_t flags, handle_t *out
98  interrupt_ack     status    handle_t irq
# MMIO for processes: a physical VMO over [res.base + offset, + size) with
# cache type VMO_CACHE_*; refused over RAM or an MSI-X table/PBA page.
99  vmo_create_physical status  handle_t res, uint64_t offset, uint64_t size, uint32_t cache, handle_t *out
# DMA: a capability bound to the function (dma_cap_create, 105 below);
# vmo_pin (106 below) writes one device address per page to addrs[] and
# the pin's id to *pin_id. vmo_unpin needs the cap the pin was made with
# (ERR_ACCESS_DENIED for any other): holding the VMO isn't enough to take
# a page away from a device still using it; RIGHT_READ on the VMO. (Numbers
# 100, dma_cap_create without its job, and 101, vmo_pin with six
# arguments, were retired in M12.)
102 vmo_unpin         status    handle_t vmo, handle_t dma, uint64_t pin_id
# vmo_create for a driver: flags VMO_CONTIGUOUS and VMO_DMA32 (either,
# both or none; any other bit is ERR_INVALID_ARGS), memory its device
# reaches by DMA, which the dma_cap `dma` lets it ask for: one bound to a
# function (ERR_ACCESS_DENIED otherwise), any rights.
103 dma_vmo_create    status    handle_t dma, uint64_t size, uint32_t flags, handle_t *out
# Bus Master Enable off; needs RIGHT_MANAGE on the device (devmgr has it,
# drivers don't). Nothing turns it on but the function's current dma_cap
# (dma_cap_bus_master).
104 pci_bus_master_off status   handle_t dev
# A dma_cap for the function `dev` (RIGHT_MANAGE: devmgr's), charged to
# `job` (RIGHT_MANAGE: a job the caller manages, the driver's own, made
# first): the cap (one JOB_LIMIT_HANDLES unit), each pin made with it (one
# unit each, until the pin goes) and, while the IOMMU translates, its
# domain's table pages (JOB_LIMIT_PAGES), now and as pins grow it. It becomes the function's current cap: bus mastering off until
# its holder turns it on (dma_cap_bus_master), the device reaching only
# what the cap pins.
105 dma_cap_create    status    handle_t dev, handle_t job, handle_t *out
# Pin args->len bytes of args->vmo from args->offset (struct vmo_pin_args,
# <jam/abi.h>) for the device of the dma_cap args->dma: committed, kept in
# place until vmo_unpin, and (while the IOMMU translates) mapped for the
# device. RIGHT_WRITE on the VMO; with VMO_PIN_READ_ONLY (the device only
# reads them) the pages are mapped for it read only and RIGHT_READ is
# enough, where the IOMMU translates (else RIGHT_WRITE is still needed). A
# read-only pin commits nothing: every page must be committed already
# (ERR_BAD_STATE otherwise, with nothing committed or charged). The pin costs the cap's job (the
# pinner's, never the VMO's holder) one JOB_LIMIT_HANDLES unit until
# vmo_unpin, the cap's close or the quarantine's release gives it back
# (ERR_NO_RESOURCES when the job can't pay). ERR_INVALID_ARGS: offset or len not
# page-aligned, len 0, an unknown flag, reserved not 0;
# ERR_OUT_OF_RANGE: past the VMO or more than VMO_PIN_MAX_PAGES pages;
# ERR_ACCESS_DENIED: the rights, or a cap bound to no function;
# ERR_BAD_STATE: the cap isn't its function's current one, its bus
# mastering is off, a page is pinned through it the other way (read only
# or writable) already, a read-only pin's page isn't committed, or the
# VMO is sealed and the pin writes.
106 vmo_pin           status    @vmo_pin_args

# console services ----------------------------------------------------------
# Rights are on a RES_ROOT handle: each call that takes the root needs its
# own power (RIGHT_ROOT_*, <jam/abi.h>), and init hands each program a copy
# of the root with only the powers it uses (RIGHT_MAP and RIGHT_SLICE,
# which reach the hardware, are never among them).
# A reader of the kernel log (needs RIGHT_ROOT_KLOG on the root):
# SIG_READABLE while the log holds bytes past what this reader last read
# (raised within a tick of a new line).
110 klog_open         status    handle_t root, handle_t *out
# Copy up to cap log bytes starting at position `pos` (bytes ever written;
# the ring keeps the last 4 MiB, KLOG_SIZE): returns how many, and *first
# gets the position of the first one (> pos if older bytes are gone). A
# pos past the end gives 0 bytes and *first = the current end, with any
# cap, 0 included (buf is not touched then): how a reader that wants only
# the recent log (the last 256 KiB, say) finds where to start.
111 klog_read         i64       handle_t reader, uint64_t pos, void *buf, uint64_t cap, uint64_t *first
# The screen (needs RIGHT_ROOT_SCREEN on the root): the boot framebuffer as a
# write-combining physical VMO + its geometry, and an owner token. From now
# on the kernel stops drawing its log on the screen (it still keeps it and
# sends it to serial); closing the last handle to the token (or the owner
# dying) gives the screen back, and the kernel redraws its log. A panic
# always draws. ERR_BAD_STATE while someone else owns it; ERR_NOT_FOUND
# with no usable framebuffer.
112 framebuffer_take  status    handle_t root, struct fb_info *info, handle_t *vmo, handle_t *owner
# Run a kernel test entry point in a kernel thread (needs RIGHT_ROOT_DEBUG
# on the root): "ktest [prefix] [words]", "soak begin" / "soak end ...",
# "bench", "stress <seconds>", "devices", "ps", "mem", "panic" (a test),
# "crash [name]" (list the crash tests, or run one: each panics on purpose
# but "bp"; ERR_NOT_FOUND for an unknown name), "memmap"
# (kernel/debug/dbgcmd.c has the words). Output goes to the kernel log
# (follow it with a klog reader).
# Blocks until done; returns the result (ktest: tests run; stress: 0 if it
# passed, else 1; devices: PCI functions; crash: how many tests / 0),
# ERR_NOT_SUPPORTED for an unknown command (or a kernel
# without tests), ERR_BAD_STATE while one runs; a command past
# DEBUG_COMMAND_MAX (63) bytes is ERR_OUT_OF_RANGE.

113 debug_command     i64       handle_t root, const char *cmd, uint64_t len
# Reset the machine (needs RIGHT_ROOT_REBOOT on the root): the ACPI reset
# register, then port 0xCF9, then the keyboard controller, then a triple
# fault. Returns only on a bad handle.
114 reboot            status    handle_t root
# COM1 input (needs RIGHT_ROOT_SERIAL on the root): one reader at a time
# (ERR_BAD_STATE while another handle is open). SIG_READABLE while bytes
# are waiting; serial_read takes up to cap of them (0 if none). The receive
# interrupt is on only while the object exists. ERR_NOT_FOUND: no UART.
115 serial_open       status    handle_t root, handle_t *out
116 serial_read       i64       handle_t h, void *buf, uint64_t cap
# Write bytes to COM1 as they are (no timestamp, not in the kernel log;
# "\n" becomes "\r\n"): a terminal on the serial port sees what the console
# shows (needs RIGHT_ROOT_SERIAL_OUT on the root). At most 4096 bytes per call.
117 serial_write      status    handle_t root, const void *buf, uint64_t len
# Name the file this boot's log is saved as (logd, once it has chosen it:
# "boot-0042"; 1..31 of A-Z a-z 0-9 - _, else ERR_INVALID_ARGS, or
# ERR_OUT_OF_RANGE past KLOG_NAME_MAX). The kernel
# only keeps it: if this boot panics, the next boot saves its copy of this
# boot's log as <name>-crash.txt. Needs RIGHT_READ on a klog reader
# (whoever follows the log names its copy).
118 klog_name         status    handle_t reader, const char *name, uint64_t len
# Who wrote the log's lines: the marks (struct klog_line) of the lines a
# process wrote (its debug_write and debug_report lines) starting at or
# past pos, in order, up to cap (at most 256 per call); the count. A
# mark's writer is the process's koid, whatever the line's text says; the
# kernel's own lines have no mark. *known gets where the marks are
# complete: a line at or past it without one is the kernel's, an older
# one's writer is not known (the kernel keeps the last 16384 marks).
# Needs RIGHT_READ on a klog reader.
119 klog_lines        i64       handle_t reader, uint64_t pos, struct klog_line *out, uint64_t cap, uint64_t *known

# driver supervision and safe rebind ----------------------------------------
# Bus Master Enable of the dma_cap's function, on (1) or off (0). Only the
# function's CURRENT cap may (the last one made for it: making one turns
# bus mastering off, ERR_BAD_STATE for an older one); a driver turns it on
# once it has quiesced its device (reset it, or seen its DMA engine idle),
# never before. Any rights on the handle. ERR_NOT_SUPPORTED: an unbound cap;
# ERR_INVALID_ARGS: `on` neither 0 nor 1.
120 dma_cap_bus_master status   handle_t dma, uint32_t on
# channel_write, but handle i arrives with rights[i] (a subset of its
# rights, else ERR_INVALID_ARGS; RIGHT_SAME keeps them): e.g. without
# RIGHT_TRANSFER / RIGHT_DUPLICATE, so the receiver can't pass it on (devmgr
# hands drivers their hardware handles this way). Each sent handle still
# needs RIGHT_TRANSFER.
121 channel_write_rights status handle_t h, const void *bytes, uint32_t nbytes, const handle_t *handles, const rights_t *rights, uint32_t nhandles

# system information for the shell (uname, free, lscpu, top, ps, date) -------
# All four only read. sys_info, cpu_stat and proc_list need
# RIGHT_ROOT_SYSINFO on a RES_ROOT handle, rtc_read RIGHT_ROOT_CLOCK.
# Structs in <jam/abi.h>.
130 sys_info          status    handle_t root, struct sys_info *out
# CPUs first.. (by index): fills up to cap entries, returns how many.
131 cpu_stat          i64       handle_t root, uint32_t first, struct cpu_stat *out, uint32_t cap
# The processes of the caller's job tree (from its root job, depth first):
# fills up to cap entries (cap <= 1024), returns how many (more may exist:
# ask again with a bigger buffer).
132 proc_list         i64       handle_t root, struct proc_stat *out, uint32_t cap
# The CMOS real-time clock (waits out an update in progress, at most ~10 ms).
133 rtc_read          status    handle_t root, struct rtc_time *out

# the wall clock (struct wall_clock, <jam/abi.h>) ----------------------------
# The time now: no handle needed (it is the uptime plus an offset).
# ERR_NOT_FOUND: no clock (no RTC reading at boot and nobody set it).
134 wallclock_get         status    struct wall_clock *out
# Set it: in->utc_ns is UTC at uptime in->uptime_ns (not in the future),
# in->zone the zone's name (printable ASCII, NUL-terminated; "" keeps the
# one set before); flags and reserved 0. RIGHT_ROOT_CLOCK on a RES_ROOT
# handle.
135 wallclock_set         status    handle_t root, const struct wall_clock *in
# The time page (struct time_page, <jam/abi.h>): *out gets a handle to it,
# a read-only VMO of one page (TIME_PAGE_RIGHTS) every process may map, to
# read clock_get's uptime and wallclock_get's UTC without a call. No
# handle or right needed. ERR_NOT_SUPPORTED if the boot couldn't make it.
137 clock_page            status    handle_t *out

# kexec: a fresh kernel started without the firmware (<jam/kexec.h>) -------
# On a RES_ROOT handle: kexec_load needs RIGHT_ROOT_KEXEC, kexec_reboot
# RIGHT_ROOT_REBOOT (as reboot does).
# Replace the stored kernel (the copy of this boot's kernel and bootfs the
# kernel keeps ready in the region reserved at boot, for a reboot or a
# panic) with the kernel ELF and the bootfs image in two VMOs (RIGHT_READ,
# each read whole). cmdline: the new kernel's command line (len 0: this
# boot's, without its one-time words; at most KEXEC_CMDLINE_MAX, 511 bytes: ERR_OUT_OF_RANGE past it). flags: 0.
# ERR_NOT_SUPPORTED: no region (crashkernel=0); ERR_INVALID_ARGS: not a
# kernel ELF or a bootfs image, a bad command line or flags;
# ERR_NO_RESOURCES: too big for the region. A refused image changes
# nothing (the old one stays stored); while the new one is written a panic
# halts on its screen.
140 kexec_load        status    handle_t root, handle_t kernel, handle_t bootfs, const char *cmdline, uint64_t len, uint32_t flags
# Start the stored kernel: every other CPU stopped, the screen the splash
# background, bus mastering off on every device, the jump. Stop the
# drivers first (devmgr's shutdown): the new kernel resets each device, but
# what one writes meanwhile lands in memory the new kernel uses. Returns
# only ERR_NOT_SUPPORTED (no region), ERR_BAD_STATE (nothing stored) or a
# handle error; a damaged image resets through the firmware instead.
141 kexec_reboot      status    handle_t root

# random numbers ------------------------------------------------------------
# len bytes (at most RANDOM_GET_MAX, 256, <jam/abi.h>) from the kernel's
# generator into buf: ChaCha20 seeded from RDSEED/RDRAND, TSC timings and
# boot data (<jam/random.h>); unpredictable, never blocks. No handle or
# right needed. len 0: OK, buf untouched. ERR_OUT_OF_RANGE: len too big;
# ERR_INVALID_ARGS: buf not all writable (part of it may have been written). libos:
# os_random.
150 random_get        status    void *buf, uint64_t len

# pagers (<jam/abi.h> has the constants and struct pager_request) -----------
# A pager supplies the pages of the VMOs made from it (pager VMOs, each
# under a key it chooses: fat's open file). An absent page touched (a
# fault, a vmo_read) queues a request in the pager, or joins the one that
# covers it already; the pager reads requests with pager_next and answers
# with pager_supply (the pages) or pager_op (a failure). Requests stay in
# the pager until answered, so a successor of a dead pager process takes
# them again (PAGER_NEXT_AGAIN). A request not answered within the pager's
# answer time fails ERR_TIMED_OUT. A pager VMO refuses vmo_write,
# vmo_commit, vmo_decommit, vmo_set_size, vmo_make_exec, vmo_pin, writable
# mappings and VMAR_KEPT_ONLY; vmo_read of an absent page waits for it
# (ERR_IO if the pager fails it, is detached or doesn't answer in time;
# ERR_CANCELED if the thread is killed). handle_info's related_koid of a
# pager VMO is its pager's koid.
# pager_create: a pager (RIGHT_ROOT_PAGER on root: volumes'), handle
# PAGER_RIGHTS. max_pages: how many pages its VMOs may hold at once (> 0;
# its budget); answer_ns: how long a request may wait for its answer
# (PAGER_ANSWER_MIN_NS .. _MAX_NS, else ERR_OUT_OF_RANGE); flags 0. The
# pager and its VMOs (structs, tables and pages) are charged to the
# caller's job. Closing its last handle detaches every VMO it made.
160 pager_create      status    handle_t root, uint64_t max_pages, uint64_t answer_ns, uint32_t flags, handle_t *out
# A pager VMO of size bytes (rounded up to pages; VMO_MAX_SIZE at most,
# ERR_OUT_OF_RANGE past it), every page absent, under key: handle
# PAGER_VMO_RIGHTS. The pager holds no handle to it. RIGHT_WRITE on the
# pager; ERR_ALREADY_EXISTS while key names a live VMO of the pager, or a
# gone one whose PAGER_REQ_GONE has no answer yet; flags 0.
161 pager_create_vmo  status    handle_t pager, uint64_t key, uint64_t size, uint32_t flags, handle_t *out
# The oldest undelivered request into *out, now delivered: ERR_SHOULD_WAIT
# if there is none (the pager is SIG_READABLE while there is). flags:
# PAGER_NEXT_AGAIN puts every delivered request without an answer back
# first. A read request is answered by pager_supply of all its pages, or
# by pager_op FAIL or DETACH; a PAGER_REQ_GONE by pager_op DETACH of its
# key, which frees the key. RIGHT_READ on the pager.
162 pager_next        status    handle_t pager, uint32_t flags, struct pager_request *out
# Fill the absent pages of [offset, offset + len) of key's VMO from buf
# (offset and len page-aligned, len one page .. PAGER_SUPPLY_MAX: else
# ERR_INVALID_ARGS / ERR_OUT_OF_RANGE); present pages are left as they
# are (supplying twice is harmless). Every request now whole is answered.
# ERR_NOT_FOUND: no live VMO has that key (detached, gone, never made);
# ERR_OUT_OF_RANGE: past the VMO's size; ERR_NO_MEMORY: the job can't pay
# for a page (the pages before it stay); ERR_INVALID_ARGS: buf unreadable.
# RIGHT_WRITE on the pager.
163 pager_supply      status    handle_t pager, uint64_t key, uint64_t offset, const void *buf, uint64_t len
# PAGER_OP_FAIL: fail the requests of key's VMO that overlap [offset,
# offset + len) (page-aligned, len > 0) with arg, ERR_IO or
# ERR_OUT_OF_RANGE. PAGER_OP_DETACH (offset, len, arg 0): cut key's VMO
# off for good: its requests, waiting and later, fail ERR_PEER_CLOSED, its
# present pages are dropped (unmapped from every mapping), and the key is
# free; or take a PAGER_REQ_GONE for key (the key is free). INVALIDATE and
# SET_SIZE: ERR_NOT_SUPPORTED (not built yet). ERR_NOT_FOUND for an
# unknown key; ERR_INVALID_ARGS for any other op or argument. RIGHT_WRITE
# on the pager.
164 pager_op          status    handle_t pager, uint64_t key, uint32_t op, uint64_t offset, uint64_t len, int64_t arg
