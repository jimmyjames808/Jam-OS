# expat's test (tools/ports-test.sh): xmlwf, the well-formedness checker, on
# a good file (status 0), a bad one (status 2, the message), and a file
# that is not there. xmlwf's exit codes: 0 well-formed, 2 not.
send run $S/printf '<?xml version="1.0"?>\n<a><b x="1">text</b><c/></a>\n' > /data/xw-good.xml
wait {prompt}
send run $S/printf '<a><b></a>\n' > /data/xw-bad.xml
wait {prompt}
send run $P/xmlwf /data/xw-good.xml; echo st-$T=$?
wait st-x=0
wait {prompt}
send run $P/xmlwf /data/xw-bad.xml; echo st-$T=$?
wait mismatched tag
wait st-x=2
wait {prompt}
send run $P/xmlwf /data/xw-nothere.xml; echo st-$T=$?
wait No such file
wait {prompt}
send rm /data/xw-good.xml /data/xw-bad.xml
wait {prompt}
