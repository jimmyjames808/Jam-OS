+// Jam OS's AudioManager (audio_manager_jamos.h).
+
+#include "media/audio/jamos/audio_manager_jamos.h"
+
+#include <algorithm>
+
+#include "base/logging.h"
+#include "media/audio/audio_device_description.h"
+#include "media/audio/fake_audio_input_stream.h"
+#include "media/audio/jamos/audio_output_stream_jamos.h"
+#include "media/audio/jamos/jam_output.h"
+#include "media/base/audio_parameters.h"
+#include "media/base/channel_layout.h"
+
+namespace media {
+
+namespace {
+
+// What the mixer plays: 48 kHz stereo, which a stream of that rate gives it
+// as it is (any other, 8 to 192 kHz, libjam resamples). Buffers of 10 ms
+// to 8192 frames (the mixer takes 2048 at a time; the stream keeps two
+// buffers queued at least).
+constexpr int kRate = 48000;
+constexpr int kRateMin = 8000;
+constexpr int kRateMax = 192000;
+constexpr int kMinBuffer = kRate / 100;
+constexpr int kMaxBuffer = 8192;
+
+}  // namespace
+
+AudioManagerJamOS::AudioManagerJamOS(std::unique_ptr<AudioThread> audio_thread,
+                                     AudioLogFactory* audio_log_factory)
+    : AudioManagerBase(std::move(audio_thread), audio_log_factory) {}
+
+AudioManagerJamOS::~AudioManagerJamOS() = default;
+
+bool AudioManagerJamOS::HasAudioOutputDevices() {
+  // A stream opened and closed: the mixer answers ERR_NOT_FOUND with no
+  // sound card behind it (and libjam when `svc audio` isn't on our list).
+  // A yes is kept (the mixer keeps its card through a driver's restart).
+  if (!has_output_) {
+    JamOutput::Result r = JamOutput::Probe();
+    has_output_ =
+        r == JamOutput::Result::kOk || r == JamOutput::Result::kNoStreams;
+  }
+  return has_output_;
+}
+
+bool AudioManagerJamOS::HasAudioInputDevices() {
+  return false;
+}
+
+bool AudioManagerJamOS::GetAudioInputDeviceNames(
+    AudioDeviceNames* device_names) {
+  device_names->clear();
+  return true;
+}
+
+bool AudioManagerJamOS::GetAudioOutputDeviceNames(
+    AudioDeviceNames* device_names) {
+  device_names->clear();
+  if (HasAudioOutputDevices()) {
+    device_names->push_back(AudioDeviceName::CreateDefault());
+  }
+  return true;
+}
+
+AudioParameters AudioManagerJamOS::GetInputStreamParameters(
+    const std::string& device_id) {
+  return AudioParameters(AudioParameters::AUDIO_PCM_LOW_LATENCY,
+                         ChannelLayoutConfig::Stereo(), kRate, kMinBuffer);
+}
+
+const std::string_view AudioManagerJamOS::GetName() {
+  return "JamOS";
+}
+
+AudioOutputStream* AudioManagerJamOS::MakeLinearOutputStream(
+    const AudioParameters& params,
+    const LogCallback& log_callback) {
+  DCHECK_EQ(AudioParameters::AUDIO_PCM_LINEAR, params.format());
+  return new AudioOutputStreamJamOS(this, params);
+}
+
+AudioOutputStream* AudioManagerJamOS::MakeLowLatencyOutputStream(
+    const AudioParameters& params,
+    const std::string& device_id,
+    const LogCallback& log_callback) {
+  DCHECK_EQ(AudioParameters::AUDIO_PCM_LOW_LATENCY, params.format());
+  if (!AudioDeviceDescription::IsDefaultDevice(device_id)) {
+    LOG(ERROR) << "jamos audio: no output device " << device_id
+               << " (only the default)";
+    return nullptr;
+  }
+  return new AudioOutputStreamJamOS(this, params);
+}
+
+AudioInputStream* AudioManagerJamOS::MakeLinearInputStream(
+    const AudioParameters& params,
+    const std::string& device_id,
+    const LogCallback& log_callback) {
+  return FakeAudioInputStream::MakeFakeStream(this, params);
+}
+
+AudioInputStream* AudioManagerJamOS::MakeLowLatencyInputStream(
+    const AudioParameters& params,
+    const std::string& device_id,
+    const LogCallback& log_callback) {
+  return FakeAudioInputStream::MakeFakeStream(this, params);
+}
+
+AudioParameters AudioManagerJamOS::GetPreferredOutputStreamParameters(
+    const std::string& output_device_id,
+    const AudioParameters& input_params) {
+  int rate = kRate;
+  ChannelLayoutConfig layout = ChannelLayoutConfig::Stereo();
+  int frames = kMinBuffer;
+  if (input_params.IsValid()) {
+    // The source's rate and its one or two channels as they are; more
+    // channels are mixed down to two.
+    if (input_params.sample_rate() >= kRateMin &&
+        input_params.sample_rate() <= kRateMax) {
+      rate = input_params.sample_rate();
+    }
+    if (input_params.channels() <= 2) {
+      layout = input_params.channel_layout_config();
+    }
+    frames = std::clamp(input_params.frames_per_buffer(), rate / 100,
+                        kMaxBuffer * rate / kRate);
+  }
+  return AudioParameters(
+      AudioParameters::AUDIO_PCM_LOW_LATENCY, layout, rate, frames,
+      AudioParameters::HardwareCapabilities(rate / 100,
+                                            kMaxBuffer * rate / kRate));
+}
+
+}  // namespace media
