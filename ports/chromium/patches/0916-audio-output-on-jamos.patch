@@ -0,0 +1,199 @@
+// Jam OS's sound output for Chromium: libjam's <audio.h> (jam_output.h).
+
+#include "media/audio/jamos/jam_output.h"
+
+#include "base/logging.h"
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+// libjam's headers come last (OK and ERR_* are macros) and as C; they are
+// the sysroot's include/jamos/libos (media/audio:jamos_libos).
+#define restrict __restrict
+extern "C" {
+#include <jamos/libjam.h>
+#include <audio.h>
+}
+#undef restrict
+
+namespace media {
+
+namespace {
+
+constexpr char kName[] = "chromium";
+
+// Openers of our own (svc_open), MIXER_STREAMS_PER_CLIENT streams each,
+// taken once the opener svc_get keeps is full: with it, the mixer's
+// MIXER_MAX_STREAMS. A browser's audio service holds a stream for each page
+// that plays (each AudioContext, each frame's media elements), all in this
+// one process. Closed when its last stream closes.
+constexpr int kOpeners = MIXER_MAX_STREAMS / MIXER_STREAMS_PER_CLIENT - 1;
+struct Opener {
+  handle_t ch;
+  unsigned streams;
+};
+Opener g_openers[kOpeners];
+
+base::Lock& OpenersLock() {
+  static base::NoDestructor<base::Lock> lock;
+  return *lock;
+}
+
+JamOutput::Result FromStatus(int st) {
+  switch (st) {
+    case OK:
+      return JamOutput::Result::kOk;
+    case ERR_SHOULD_WAIT:
+      return JamOutput::Result::kWait;
+    case ERR_NOT_FOUND:
+      return JamOutput::Result::kNoDevice;
+    case ERR_NO_RESOURCES:
+      return JamOutput::Result::kNoStreams;
+    case ERR_PEER_CLOSED:
+      return JamOutput::Result::kGone;
+    default:
+      LOG(ERROR) << "jamos audio: " << status_str(st);
+      return JamOutput::Result::kFailed;
+  }
+}
+
+}  // namespace
+
+struct JamOutput::Out {
+  struct audio_out a;
+  handle_t event = HANDLE_INVALID;
+  uint64_t rate = AUDIO_RATE;
+  uint64_t lead = 0;  // the mixer's frames (48 kHz)
+};
+
+JamOutput::JamOutput() : out_(std::make_unique<Out>()) {}
+
+JamOutput::~JamOutput() {
+  Close();
+}
+
+JamOutput::Result JamOutput::Open(int rate, int channels) {
+  DCHECK(!open_);
+  int st = audio_open_fmt(&out_->a, rate, channels, AUDIO_F32, kName);
+  if (st == ERR_NO_RESOURCES) {
+    base::AutoLock hold(OpenersLock());
+    for (int i = 0; i < kOpeners && st == ERR_NO_RESOURCES; i++) {
+      Opener& o = g_openers[i];
+      if (o.streams >= MIXER_STREAMS_PER_CLIENT) {
+        continue;
+      }
+      if (o.ch == HANDLE_INVALID && svc_open(SVC_AUDIO, &o.ch) != OK) {
+        o.ch = HANDLE_INVALID;
+        break;
+      }
+      st = audio_open_on(&out_->a, o.ch, rate, channels, AUDIO_F32, kName);
+      if (st == OK) {
+        o.streams++;
+        opener_ = i;
+      } else if (o.streams == 0) {
+        jam_handle_close(o.ch);
+        o.ch = HANDLE_INVALID;
+      }
+    }
+  }
+  if (st != OK) {
+    return FromStatus(st);
+  }
+  open_ = true;
+  out_->event = audio_room_event(&out_->a);
+  out_->rate = static_cast<uint64_t>(rate);
+  // The mixer's lead: what it takes at once when it opens the device.
+  struct audio_pos pos;
+  out_->lead = audio_position(&out_->a, &pos) == OK ? pos.lead : 4 * 2048;
+  return Result::kOk;
+}
+
+void JamOutput::Close() {
+  if (!open_) {
+    return;
+  }
+  audio_close(&out_->a);
+  open_ = false;
+  if (opener_ >= 0) {
+    base::AutoLock hold(OpenersLock());
+    Opener& o = g_openers[opener_];
+    if (--o.streams == 0) {
+      jam_handle_close(o.ch);
+      o.ch = HANDLE_INVALID;
+    }
+    opener_ = -1;
+  }
+}
+
+long JamOutput::Write(const float* frames, size_t n, Result* error) {
+  long done = audio_try_write(&out_->a, frames, n);
+  if (done < 0) {
+    *error = FromStatus(static_cast<int>(done));
+  }
+  return done;
+}
+
+size_t JamOutput::Queued() const {
+  // As the room counts them, so that room for n (ArmRoom) is never fewer
+  // than RoomMax() - n queued here.
+  return audio_room_max(&out_->a) - audio_room(&out_->a);
+}
+
+size_t JamOutput::Lead() const {
+  return static_cast<size_t>((out_->lead * out_->rate + AUDIO_RATE - 1) /
+                             AUDIO_RATE);
+}
+
+size_t JamOutput::RoomMax() const {
+  return audio_room_max(&out_->a);
+}
+
+JamOutput::Result JamOutput::ArmRoom(size_t frames) {
+  return FromStatus(audio_arm_room(&out_->a, frames));
+}
+
+JamOutput::Result JamOutput::WaitForRoom(base::TimeDelta timeout) {
+  signals_t seen = 0;
+  int st = jam_object_wait_one(
+      out_->event, MIXER_SIG_SPACE,
+      now() + static_cast<uint64_t>(timeout.InNanoseconds()), &seen);
+  return st == ERR_TIMED_OUT ? Result::kOk : FromStatus(st);
+}
+
+void JamOutput::Wake() {
+  // The event's own bit: the waiter takes it for the mixer's.
+  jam_event_signal(out_->event, 0, MIXER_SIG_SPACE);
+}
+
+JamOutput::Result JamOutput::Position(base::TimeDelta* delay,
+                                      base::TimeTicks* at) {
+  struct audio_pos pos;
+  int st = audio_position(&out_->a, &pos);
+  if (st != OK) {
+    return FromStatus(st);
+  }
+  *delay = base::Nanoseconds(static_cast<int64_t>(pos.latency_ns));
+  *at = base::TimeTicks() + base::Nanoseconds(static_cast<int64_t>(pos.at));
+  return Result::kOk;
+}
+
+JamOutput::Result JamOutput::Start() {
+  return FromStatus(audio_start(&out_->a));
+}
+
+JamOutput::Result JamOutput::Pause() {
+  return FromStatus(audio_pause(&out_->a));
+}
+
+JamOutput::Result JamOutput::Discard() {
+  return FromStatus(audio_discard(&out_->a));
+}
+
+// static
+JamOutput::Result JamOutput::Probe() {
+  JamOutput probe;
+  Result r = probe.Open(AUDIO_RATE, 2);
+  probe.Close();
+  return r;
+}
+
+}  // namespace media
