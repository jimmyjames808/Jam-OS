+// Jam OS's sound output for Chromium (ports/chromium in Jam OS, its
+// docs/CR-PLAN.md section 11): one stream on Jam OS's mixer through libjam's
+// <audio.h>, float samples at the stream's rate. This file and
+// jam_output.cc are the only ones that see libjam's headers (their status
+// names, OK and ERR_*, are macros); AudioOutputStreamJamOS uses this.
+//
+// One thread uses an output at a time (libjam's rule), except Wake(),
+// which any thread may call. Every call but WaitForRoom() returns at once
+// or after one call into the mixer.
+
+#ifndef MEDIA_AUDIO_JAMOS_JAM_OUTPUT_H_
+#define MEDIA_AUDIO_JAMOS_JAM_OUTPUT_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/time/time.h"
+
+namespace media {
+
+class JamOutput {
+ public:
+  enum class Result {
+    kOk,
+    kWait,       // no room yet: WaitForRoom()
+    kNoDevice,   // no mixer on our list, or no sound card behind it
+    kNoStreams,  // the mixer has all the streams it takes
+    kGone,       // the mixer was given up on: close and open again
+    kFailed,     // anything else (said in the log)
+  };
+
+  JamOutput();
+  JamOutput(const JamOutput&) = delete;
+  JamOutput& operator=(const JamOutput&) = delete;
+  ~JamOutput();  // closes
+
+  // A stream of `rate` Hz (8000 to 192000) and 1 or 2 channels, named
+  // "chromium" for `vol`, stopped. Past the four streams the process's
+  // opener holds, it opens on openers of its own (16 streams in all).
+  Result Open(int rate, int channels);
+  void Close();
+  bool is_open() const { return open_; }
+
+  // Interleaved frames into the ring, as many as there is room for: how
+  // many, or a negative number (then *error says why).
+  long Write(const float* frames, size_t n, Result* error);
+  // Frames written that the mixer hasn't taken, in our frames (as the
+  // ring's room counts them: RoomMax() less the room).
+  size_t Queued() const;
+  // The mixer's lead in our frames: how far ahead of what is heard it
+  // takes frames (4 periods, 171 ms), all at once when it opens the device.
+  size_t Lead() const;
+  // The most the ring holds, in our frames.
+  size_t RoomMax() const;
+  // kOk: the ring has room for `frames` now; kWait: WaitForRoom(), which
+  // returns when the mixer has taken some (once a period, 43 ms), at
+  // Wake(), or after `timeout`. Then ask again.
+  Result ArmRoom(size_t frames);
+  Result WaitForRoom(base::TimeDelta timeout);
+  // Ends a WaitForRoom() on another thread.
+  void Wake();
+
+  // How long until a frame written now is heard, and when that was so
+  // (base::TimeTicks: the kernel clock, as CLOCK_MONOTONIC is).
+  Result Position(base::TimeDelta* delay, base::TimeTicks* at);
+
+  // The mixer takes frames (Start) or stops taking them, keeping what is
+  // in the ring (Pause); Discard drops the ring (on a paused stream at
+  // once, with no fade).
+  Result Start();
+  Result Pause();
+  Result Discard();
+
+  // Whether the mixer takes a stream now: one opened and closed.
+  static Result Probe();
+
+ private:
+  struct Out;
+  std::unique_ptr<Out> out_;
+  bool open_ = false;
+  int opener_ = -1;  // the opener of our own it holds a place on, or -1
+};
+
+}  // namespace media
+
+#endif  // MEDIA_AUDIO_JAMOS_JAM_OUTPUT_H_
