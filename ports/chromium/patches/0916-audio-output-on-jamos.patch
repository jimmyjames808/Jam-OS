+// Jam OS's AudioOutputStream (audio_output_stream_jamos.h).
+
+#include "media/audio/jamos/audio_output_stream_jamos.h"
+
+#include <algorithm>
+
+#include "base/check.h"
+#include "base/logging.h"
+#include "media/audio/jamos/audio_manager_jamos.h"
+#include "media/base/audio_bus.h"
+#include "media/base/audio_glitch_info.h"
+#include "media/base/audio_sample_types.h"
+#include "media/base/audio_timestamp_helper.h"
+
+namespace media {
+
+namespace {
+
+// A wait for room is cut into slices this long, so a stream whose mixer
+// stopped answering still sees Stop() (which wakes the wait anyway).
+constexpr base::TimeDelta kWaitSlice = base::Milliseconds(100);
+
+}  // namespace
+
+AudioOutputStreamJamOS::AudioOutputStreamJamOS(AudioManagerJamOS* manager,
+                                               const AudioParameters& params)
+    : manager_(manager),
+      params_(params),
+      bus_(AudioBus::Create(params)),
+      interleaved_(static_cast<size_t>(params.frames_per_buffer()) *
+                   static_cast<size_t>(params.channels())) {}
+
+AudioOutputStreamJamOS::~AudioOutputStreamJamOS() {
+  DCHECK(thread_.is_null());
+}
+
+bool AudioOutputStreamJamOS::Open() {
+  JamOutput::Result r = out_.Open(params_.sample_rate(), params_.channels());
+  if (r != JamOutput::Result::kOk) {
+    LOG(WARNING) << "jamos audio: no stream from the mixer ("
+                 << (r == JamOutput::Result::kNoDevice    ? "no sound device"
+                     : r == JamOutput::Result::kNoStreams ? "all its streams taken"
+                                                          : "an error")
+                 << ")";
+    return false;
+  }
+  const size_t buffer = static_cast<size_t>(params_.frames_per_buffer());
+  const size_t lead = out_.Lead();
+  const size_t period = (lead + 3) / 4;
+  auto whole_buffers = [buffer](size_t frames) {
+    return (frames + buffer - 1) / buffer * buffer;
+  };
+  // What the mixer takes when it opens the device, and a period more; then
+  // two periods (and never less than two buffers).
+  preroll_ = whole_buffers(lead + period);
+  target_ = whole_buffers(std::max(2 * period, 2 * buffer));
+  CHECK_LE(preroll_ + buffer, out_.RoomMax());
+  wake_room_ = out_.RoomMax() - target_ + buffer;
+  VLOG(1) << "jamos audio: a stream of " << params_.sample_rate() << " Hz, "
+          << params_.channels() << " channel(s), buffers of " << buffer
+          << " frames; pre-roll " << preroll_ << ", queue " << target_;
+  return true;
+}
+
+void AudioOutputStreamJamOS::Start(AudioSourceCallback* callback) {
+  DCHECK(out_.is_open());
+  DCHECK(thread_.is_null());
+  callback_ = callback;
+  stop_.store(false);
+  VLOG(1) << "jamos audio: start";
+  if (!base::PlatformThread::CreateWithType(
+          0, this, &thread_, base::ThreadType::kRealtimeAudio)) {
+    thread_ = base::PlatformThreadHandle();
+    callback_->OnError(AudioSourceCallback::ErrorType::kUnknown);
+  }
+}
+
+void AudioOutputStreamJamOS::Stop() {
+  if (!thread_.is_null()) {
+    stop_.store(true);
+    out_.Wake();
+    base::PlatformThread::Join(thread_);
+    thread_ = base::PlatformThreadHandle();
+    // What the mixer had taken is not heard (or played out, if another
+    // stream keeps the device open); the queue goes.
+    out_.Pause();
+    out_.Discard();
+    VLOG(1) << "jamos audio: stop";
+  }
+  callback_ = nullptr;
+}
+
+void AudioOutputStreamJamOS::Flush() {
+  if (out_.is_open() && thread_.is_null()) {
+    out_.Discard();
+  }
+}
+
+void AudioOutputStreamJamOS::SetVolume(double volume) {
+  DCHECK(0.0 <= volume && volume <= 1.0) << volume;
+  volume_.store(static_cast<float>(volume));
+}
+
+void AudioOutputStreamJamOS::GetVolume(double* volume) {
+  *volume = volume_.load();
+}
+
+void AudioOutputStreamJamOS::Close() {
+  Stop();
+  out_.Close();
+  manager_->ReleaseOutputStream(this);  // deletes this
+}
+
+void AudioOutputStreamJamOS::ThreadMain() {
+  base::PlatformThread::SetName("JamAudioOutput");
+  if (!Fill(preroll_, false)) {
+    return;
+  }
+  if (out_.Start() != JamOutput::Result::kOk) {
+    ReportError();
+    return;
+  }
+  while (!stop_.load()) {
+    JamOutput::Result r = out_.ArmRoom(wake_room_);
+    // Stop() sets stop_ and then wakes: a wake that came before the arm
+    // (which clears it) is seen here instead.
+    if (r == JamOutput::Result::kWait && !stop_.load()) {
+      r = out_.WaitForRoom(kWaitSlice);
+    }
+    if (stop_.load()) {
+      break;
+    }
+    if (r != JamOutput::Result::kOk && r != JamOutput::Result::kWait) {
+      ReportError();
+      return;
+    }
+    if (!Fill(target_, true)) {
+      return;
+    }
+  }
+}
+
+bool AudioOutputStreamJamOS::Fill(size_t target, bool started) {
+  size_t queued = out_.Queued();
+  if (queued >= target) {
+    return true;
+  }
+  // The source's delay: how long until its next frame is heard. Before
+  // the start, the time from the start (the first frame is heard as the
+  // mixer opens the device).
+  base::TimeDelta delay;
+  base::TimeTicks at;
+  if (started) {
+    if (out_.Position(&delay, &at) != JamOutput::Result::kOk) {
+      ReportError();
+      return false;
+    }
+  } else {
+    delay = AudioTimestampHelper::FramesToTime(queued, params_.sample_rate());
+    at = base::TimeTicks::Now();
+  }
+  const int frames = bus_->frames();
+  const base::TimeDelta duration = params_.GetBufferDuration();
+  while (queued < target && !stop_.load()) {
+    int filled = callback_->OnMoreData(delay, at, {}, bus_.get());
+    if (filled < frames) {
+      bus_->ZeroFramesPartial(filled, frames - filled);
+    }
+    const float volume = volume_.load();
+    if (volume != 1.0f) {
+      bus_->Scale(volume);
+    }
+    bus_->ToInterleaved<Float32SampleTypeTraits>(interleaved_);
+    JamOutput::Result error = JamOutput::Result::kOk;
+    long written = out_.Write(interleaved_.data(), frames, &error);
+    if (written < 0) {
+      ReportError();
+      return false;
+    }
+    // The ring holds far more than the target: it takes the whole buffer.
+    DCHECK_EQ(written, frames);
+    queued += static_cast<size_t>(frames);
+    delay += duration;
+  }
+  return true;
+}
+
+void AudioOutputStreamJamOS::ReportError() {
+  LOG(WARNING) << "jamos audio: the mixer's stream failed";
+  callback_->OnError(AudioSourceCallback::ErrorType::kUnknown);
+}
+
+}  // namespace media
