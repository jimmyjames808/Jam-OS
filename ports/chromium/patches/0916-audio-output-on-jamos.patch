+// Jam OS's AudioOutputStream (ports/chromium in Jam OS, its
+// docs/CR-PLAN.md section 11): a stream on Jam OS's mixer (JamOutput),
+// fed by a thread of its own that waits for the mixer to take frames.
+//
+// The mixer takes a period (2048 frames, 43 ms) at a time from the
+// stream's ring, and its lead (4 periods, 171 ms) at once when it opens the
+// device. So Start() pre-rolls the lead and a period, then lets the mixer
+// take, and from then on the thread wakes each time the mixer has taken
+// frames and asks the source for buffers until two periods are queued
+// again. Stop() ends the thread and throws the queue away (Jam OS's pause
+// then discard): a Start() after it goes on with the source's next frames.
+
+#ifndef MEDIA_AUDIO_JAMOS_AUDIO_OUTPUT_STREAM_JAMOS_H_
+#define MEDIA_AUDIO_JAMOS_AUDIO_OUTPUT_STREAM_JAMOS_H_
+
+#include <atomic>
+#include <memory>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/threading/platform_thread.h"
+#include "media/audio/audio_io.h"
+#include "media/audio/jamos/jam_output.h"
+#include "media/base/audio_parameters.h"
+
+namespace media {
+
+class AudioBus;
+class AudioManagerJamOS;
+
+class AudioOutputStreamJamOS : public AudioOutputStream,
+                               public base::PlatformThread::Delegate {
+ public:
+  // The manager outlives the stream.
+  AudioOutputStreamJamOS(AudioManagerJamOS* manager,
+                         const AudioParameters& params);
+  AudioOutputStreamJamOS(const AudioOutputStreamJamOS&) = delete;
+  AudioOutputStreamJamOS& operator=(const AudioOutputStreamJamOS&) = delete;
+  ~AudioOutputStreamJamOS() override;
+
+  // AudioOutputStream, on the audio thread.
+  bool Open() override;
+  void Start(AudioSourceCallback* callback) override;
+  void Stop() override;
+  void Flush() override;
+  void SetVolume(double volume) override;
+  void GetVolume(double* volume) override;
+  void Close() override;
+
+ private:
+  // The thread: pre-roll, start, then a fill each time there is room.
+  void ThreadMain() override;
+  // Buffers from the source until `target` frames are queued; false if
+  // the stream failed (the source was told).
+  bool Fill(size_t target, bool started);
+  void ReportError();
+
+  const raw_ptr<AudioManagerJamOS> manager_;
+  const AudioParameters params_;
+  const std::unique_ptr<AudioBus> bus_;
+  std::vector<float> interleaved_;
+  JamOutput out_;
+
+  // Our frames: the pre-roll, what the thread keeps queued, and the room
+  // that wakes it (a buffer's below that).
+  size_t preroll_ = 0;
+  size_t target_ = 0;
+  size_t wake_room_ = 0;
+
+  // Set by Start() before the thread starts, cleared by Stop() after it
+  // ends.
+  raw_ptr<AudioSourceCallback> callback_ = nullptr;
+  base::PlatformThreadHandle thread_;
+  std::atomic<bool> stop_{false};
+  std::atomic<float> volume_{1.0f};
+};
+
+}  // namespace media
+
+#endif  // MEDIA_AUDIO_JAMOS_AUDIO_OUTPUT_STREAM_JAMOS_H_
