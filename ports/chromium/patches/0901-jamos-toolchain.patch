--- /dev/null
+++ b/build/toolchain/jamos/BUILD.gn
@@ -0,0 +1,53 @@
+# Jam OS's toolchains for Chromium (ports/chromium in Jam OS, its
+# docs/CR-PLAN.md section 1): Chromium's Linux code built for Jam OS's POSIX
+# layer, a musl sysroot. args.gn selects them and describes the target:
+#
+#   custom_toolchain = "//build/toolchain/jamos:x64"
+#   host_toolchain = "//build/toolchain/jamos:host"
+#   is_jamos = true
+#   is_musl = true
+#   target_sysroot = "<Jam OS's sysroot>"
+#   jamos_link_driver = "<the port's link driver>"
+#
+# (The default toolchain's arguments are args.gn's: GN ignores its
+# toolchain_args. So the target's settings are the build's, and the host
+# toolchain puts Linux's back.)
+#
+# x64, the target: compiles are Chromium's own clang (clang_toolchain) for
+# x86_64-unknown-linux-musl against the sysroot, with __jamos__ defined;
+# __linux__ stays defined (the target is Linux's ABI as musl gives it).
+# Links are Jam OS's driver (tools/jamos-clang through the port's wrapper):
+# static and position-dependent (Jam OS runs ET_EXEC programs only), by lld
+# through Jam OS's posix.ld, with LLVM's runtimes and musl from the
+# sysroot, and the program's list as its ELF note.
+
+import("//build/toolchain/gcc_toolchain.gni")
+import("//build/toolchain/jamos/jamos.gni")
+
+clang_toolchain("x64") {
+  assert(is_jamos && is_musl, "args.gn sets is_jamos and is_musl for Jam OS")
+  assert(jamos_link_driver != "", "jamos_link_driver is the port's link driver")
+  ld = jamos_link_driver
+  extra_cppflags = "--target=x86_64-unknown-linux-musl -D__jamos__=1"
+  extra_asmflags = "--target=x86_64-unknown-linux-musl"
+  extra_ldflags = "--target=x86_64-unknown-linux-musl"
+
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "linux"
+  }
+}
+
+# The host: Chromium's own Linux clang toolchain (as
+# //build/toolchain/linux:clang_x64), with the target's Jam OS settings
+# undone, against Chromium's Debian sysroot: what it builds runs on the
+# build host (V8's mksnapshot, the generators, Rust's build scripts).
+clang_toolchain("host") {
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "linux"
+    is_jamos = false
+    is_musl = false
+    sysroot = "//build/linux/debian_bullseye_amd64-sysroot"
+  }
+}
--- /dev/null
+++ b/build/toolchain/jamos/jamos.gni
@@ -0,0 +1,11 @@
+# Jam OS's toolchains for Chromium (build/toolchain/jamos/BUILD.gn).
+
+declare_args() {
+  # The target is Jam OS: a static, position-dependent program. args.gn
+  # sets it; Jam OS's host toolchain puts it back to false.
+  is_jamos = false
+
+  # The program that links for Jam OS: tools/jamos-clang, through the port's
+  # wrapper (it chooses each program's list by the output's name).
+  jamos_link_driver = ""
+}
