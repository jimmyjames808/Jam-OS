--- a/third_party/swiftshader/src/Reactor/ExecutableMemory.cpp
+++ b/third_party/swiftshader/src/Reactor/ExecutableMemory.cpp
@@ -279,6 +279,16 @@
 #if defined(_WIN32)
 	return VirtualAlloc(nullptr, length, MEM_COMMIT | MEM_RESERVE,
 	                    permissionsToProtectMode(permissions));
+#elif defined(__jamos__)
+	// Jam OS: only JIT memory (MAP_JIT, which needs the process's JIT
+	// power) can be made executable, never a memfd's pages (macOS's way).
+	int flags = MAP_PRIVATE | MAP_ANONYMOUS | (need_exec ? MAP_JIT : 0);
+	mapping = mmap(nullptr, length, permissionsToMmapProt(permissions), flags, -1, 0);
+
+	if(mapping == MAP_FAILED)
+	{
+		mapping = nullptr;
+	}
