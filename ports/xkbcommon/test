# xkbcommon's test (tools/ports-test.sh): its own tools compile and query the
# compositor's keymap, the US layout's XKB text that tools/genkeymap.py makes
# (share/xkbcommon-test/us.xkb in the xkbcommon-test package, a copy that
# `genkeymap.py check` keeps current). The expected lines are what the same
# xkbcommon 1.13.2 printed built for x86-64 Linux (2026-10-11).
send K=/data/pkg/share/xkbcommon-test/us.xkb; X=/data/pkg/libexec/xkbcommon
wait {prompt}
# the keymap compiles and prints back as 720 lines
send run $X/xkbcli-compile-keymap --from-xkb $K | run $S/wc -l | run $S/sed s/^/count-/
wait count-720
wait {prompt}
# a keymap that is not one is refused
send run $S/printf 'garbage {\n' > /data/xkb-bad.xkb; run $X/xkbcli-compile-keymap --from-xkb /data/xkb-bad.xkb; echo st-$T=$?
wait Failed to parse input xkb file
wait st-x=1
wait {prompt}
send rm /data/xkb-bad.xkb
wait {prompt}
# 'a' is the key AC01 (code 38) alone; 'A' needs Shift; '!' is Shift+1
send run $X/xkbcli-how-to-type --disable-compose --keymap=$K a
wait keysym: a (0x0061)
wait 38       AC01      1        English (US)         1       [ ]
wait {prompt}
send run $X/xkbcli-how-to-type --disable-compose --keymap=$K A
wait keysym: A (0x0041)
wait 38       AC01      1        English (US)         2       [ Shift ]
wait {prompt}
send run $X/xkbcli-how-to-type --disable-compose --keymap=$K '!'
wait keysym: exclam (0x0021)
wait 10       AE01      1        English (US)         2       [ Shift ]
wait {prompt}
send run $X/xkbcli-how-to-type --disable-compose --keymap=$K --keysym Return
wait keysym: Return (0xff0d)
wait 36       RTRN      1        English (US)         1       [ ]
wait {prompt}
